# ============================================
# Library Mobile App - Environment Config
# ============================================
#
# IMPORTANT: Copy this file to .env and update values for your setup
#
# Android Emulator: http://10.0.2.2:80/api (default - maps to host localhost)
# iOS Simulator: http://localhost:80/api
# Real Device (same network): http://<your-pc-ip>:80/api
#
# To find your PC IP on Windows:
#   ipconfig | Select-String "IPv4"
#
# If login fails with "Cannot connect to server":
#   1. Make sure Docker containers are running: docker compose up -d
#   2. Try accessing http://localhost:80/api/healthz from your browser
#   3. If localhost works but 10.0.2.2 doesn't, the emulator can't reach Docker
#   4. On Windows with Docker Desktop, try restarting Docker and running:
#      docker compose down && docker compose up -d

EXPO_PUBLIC_API_URL=http://192.168.1.166:80/api

# Web frontend URL for 3D tour and other web views
# Android Emulator: http://10.0.2.2:3000
# iOS Simulator: http://localhost:3000
# Real Device (same network): http://<your-pc-ip>:3000
EXPO_PUBLIC_WEB_URL=http://192.168.1.166:3000