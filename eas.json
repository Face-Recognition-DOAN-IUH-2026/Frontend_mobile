      "env": {
        "EXPO_PUBLIC_API_URL": "https://iuhlib-api.duckdns.org/api",
        "EXPO_PUBLIC_WEB_URL": "https://frontend-web-fawn-kappa.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://iuhlib-api.duckdns.org/api",
        "EXPO_PUBLIC_WEB_URL": "https://frontend-web-fawn-kappa.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
