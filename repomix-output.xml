            disabled={!manualValue.trim()}
            style={s.submitBtn}
          >
            OK
          </Button>
        </View>
      )}

      <View style={s.actions}>
        {showPickImage && onPickImage && (
          <Button
            mode="outlined"
            onPress={onPickImage}
            icon="image"
            style={s.actionBtn}
            labelStyle={s.actionLabel}
            textColor={c.onSurface}
