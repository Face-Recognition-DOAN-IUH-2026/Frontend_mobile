            style={styles.manualLookupButton}
          >
            Thêm
          </Button>
        </View>
      ) : null}

      <SectionCard
        title={`Danh sách mượn (${scannedItems.length} cuốn)`}
        icon="book-open-variant"
        accentColor={GRADIENTS.violet[0]}
        right={
