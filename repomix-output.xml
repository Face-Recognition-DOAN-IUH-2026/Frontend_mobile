}

/* ─── Filter Pill ─── */
export function FilterPill({
  label,
  active,
  onPress,
}: {
  label: string;
  active: boolean;
  onPress: () => void;
}) {
  const theme = useTheme() as AppTheme;
  const c = theme.colors;

  return (
    <View
      style={[
        dhStyles.pill,
        {
          backgroundColor: active ? c.primary : 'transparent',
