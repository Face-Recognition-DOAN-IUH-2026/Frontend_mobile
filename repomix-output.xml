              }
              return part.text ? (
                <View key={idx} style={styles.assistantBubble}>
                  <Text style={styles.assistantText}>{part.text}</Text>
                </View>
              ) : null;
            })}
          </View>
        </View>
      )}
    </View>
  );
}

