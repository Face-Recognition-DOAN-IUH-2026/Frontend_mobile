<file path="src/api/client.ts">
import axios, { AxiosInstance, AxiosError, AxiosRequestConfig } from 'axios';
import { getAccessToken, getRefreshToken, setAccessToken, setRefreshToken, clearTokens } from './secureStorage';
import { devError } from '../utils/logger';
import { API_BASE_URL } from '../config/api';
import bus from '../lib/event-bus';
import { getSessionGeneration, saveSessionTokens } from './secureStorage';

let _isRefreshing = false;
let refreshController: AbortController | null = null;
let _refreshSubscribers: Array<{ resolve: (token: string) => void; reject: (error: unknown) => void }> = [];

function onTokenRefreshed(newToken: string) {
  const subscribers = _refreshSubscribers;
  _refreshSubscribers = [];
  subscribers.forEach(({ resolve }) => resolve(newToken));
}

export function cancelPendingRequests() {
  refreshController?.abort();
  refreshController = null;
  const queue = _refreshSubscribers;
  _isRefreshing = false;
  _refreshSubscribers = [];
  queue.forEach(({ reject }) => reject(new Error('Session expired')));
}

const AUTH_SKIP_REFRESH_ENDPOINTS = [
  '/auth/login',
  '/patrons/login',
  '/auth/refresh',
  '/patrons/register',
  '/auth/pre-register-otp',
  '/auth/pre-register-verify',
  '/patrons/check-exists',
  '/patrons/check-code',
  '/auth/forgot-password',
  '/auth/verify-reset-code',
  '/auth/reset-password',
  '/auth/face-login',
];

export function shouldSkipAuthRefresh(url?: string): boolean {
  if (!url) return false;
  return AUTH_SKIP_REFRESH_ENDPOINTS.some((p) => url.includes(p));
}

const api: AxiosInstance = axios.create({
  baseURL: API_BASE_URL,
  timeout: 30000,
});

const refreshApi: AxiosInstance = axios.create({
  baseURL: API_BASE_URL,
  timeout: 15000,
});

api.interceptors.request.use(
  async (config) => {
    try {
      const token = await getAccessToken();
      if (token) {
        config.headers.Authorization = `Bearer ${token}`;
      }
    } catch (err) {
      devError('[API] Failed to get token from storage:', err);
    }
    return config;
  },
  (error) => Promise.reject(error)
);

api.interceptors.response.use(
  (response) => {
    if (response.headers['x-legacy-routed'] === 'true') {
      bus.emit('app:legacy-routed');
    }
    return response;
  },
  async (error: AxiosError) => {
    const originalRequest = error.config as AxiosRequestConfig & { _retry?: boolean };

    if (error.response?.status === 401 && originalRequest && !originalRequest._retry) {
      const endpoint = originalRequest?.url || 'unknown';
      const method = originalRequest?.method?.toUpperCase() || 'GET';
      devError(`[API] 401 received for ${method} ${endpoint}`);

      if (shouldSkipAuthRefresh(originalRequest.url)) {
        devError(`[API] Skipping refresh for auth endpoint: ${endpoint}`);
        return Promise.reject(error);
      }

      originalRequest._retry = true;
      if (_isRefreshing) {
        return new Promise<string>((resolve, reject) => {
          _refreshSubscribers.push({ resolve, reject });
        }).then((token) => {
            originalRequest.headers = { ...originalRequest.headers, Authorization: `Bearer ${token}` };
            return api(originalRequest);
        });
      }

      _isRefreshing = true;
      const controller = new AbortController();
      const generation = getSessionGeneration();
      refreshController = controller;

      try {
        // Fast-path: if both tokens are already gone the user has intentionally
        // logged out. Do NOT attempt a refresh and do NOT emit auth:expired —
        // the navigation to login is already handled by the logout() call.
        const [existingAccess, existingRefresh] = await Promise.all([
          getAccessToken(),
          getRefreshToken(),
        ]);
        if (!existingAccess && !existingRefresh) {
          _isRefreshing = false;
          refreshController = null;
          cancelPendingRequests();
          return Promise.reject(error);
        }

        const refreshToken = existingRefresh ?? await getRefreshToken();
        if (controller.signal.aborted) throw new Error('Session expired');
        if (!refreshToken) throw { response: { status: 401 } };
        const { data } = await refreshApi.post(
          '/auth/refresh',
          { refresh_token: refreshToken },
          { headers: { Authorization: undefined }, signal: controller.signal },
        );
        const newAccessToken = data.access_token;
        if (controller.signal.aborted) throw new Error('Session expired');
        if (typeof newAccessToken !== 'string' || !newAccessToken) throw new Error('Invalid refresh response');
        const newRefreshToken = data.refresh_token;
        await saveSessionTokens(newAccessToken, newRefreshToken, generation);
        if (controller.signal.aborted || generation !== getSessionGeneration()) throw new Error('Session changed');
        _isRefreshing = false;
        refreshController = null;
        onTokenRefreshed(newAccessToken);
        originalRequest.headers = { ...originalRequest.headers, Authorization: `Bearer ${newAccessToken}` };
        return api(originalRequest);
      } catch (refreshErr: any) {
        _isRefreshing = false;
        refreshController = null;
        if (controller.signal.aborted) return Promise.reject(refreshErr);
        devError('[API] Refresh token failed:', refreshErr);
        cancelPendingRequests();
        if (refreshErr?.response?.status === 401 || refreshErr?.response?.status === 403) {
          try { await clearTokens(); } catch { /* ignore */ }
          bus.emit('auth:expired');
        }
        return Promise.reject(refreshErr);
      }
    }
    return Promise.reject(error);
  }
);

export default api;
</file>

<file path="src/context/AuthContext.tsx">
import React, { createContext, useContext, useState, useEffect, useCallback, ReactNode } from 'react';
import { Platform } from 'react-native';
import * as Notifications from 'expo-notifications';

// Guard: expo-notifications needs native modules not available in Expo Go
function isNotificationsAvailable(): boolean {
  try {
    require('expo-notifications/build/NotificationPermissionsModule');
    return true;
  } catch {
    return false;
  }
}
const NOTIFS_AVAILABLE = isNotificationsAvailable();
import { User, UserRole } from '../types';
import { authApi } from '../api/auth';
import { notificationApi } from '../api/notification';
import { devError } from '../utils/logger';
import { queryClient } from '../lib/queryClient';
import { getAccessToken, getRefreshToken, setAccessToken, setRefreshToken, clearTokens } from '../api/secureStorage';
import { cancelPendingRequests } from '../api/client';
import bus from '../lib/event-bus';
import { getSessionGeneration, saveSessionTokens } from '../api/secureStorage';
import { useAIWidgetStore } from '../features/ai/components/AIWidget/useAIWidgetStore';

interface JwtPayload {
  sub?: string;
  email?: string;
  full_name?: string;
  fullName?: string;
  role?: string;
  roles?: string[];
  exp?: number;
  userId?: string;
}

export interface Patron {
  id: string;
  email?: string;
  full_name?: string;
  fullName?: string;
  avatar_url?: string;
  avatarUrl?: string;
  permanent_address?: string;
  phone?: string;
  faculty?: string;
  student_code?: string;
  password_auto_generated?: boolean;
  role?: string;
}

interface AuthContextType {
  user: User | null;
  patron: any | null;
  isLoading: boolean;
  isAuthenticated: boolean;
  staffLogin: (email: string, password: string) => Promise<void>;
  patronLogin: (studentCode: string, password: string) => Promise<void>;
  faceLogin: (imageUri: string) => Promise<void>;
  logout: () => Promise<void>;
  updateUser: (patch: Partial<User>) => void;
  updatePatron: (patch: Partial<Patron>) => void;
  restoreUserFromToken: () => Promise<void>;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

function getFullName(data: User | Patron): string {
  return (data as any).fullName || (data as any).full_name || '';
}

function decodeJwtPayload(token: string): JwtPayload | null {
  try {
    const base64 = token.split('.')[1];
    const json = atob(base64.replace(/-/g, '+').replace(/_/g, '/'));
    return JSON.parse(json) as JwtPayload;
  } catch {
    return null;
  }
}

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<User | null>(null);
  const [patron, setPatron] = useState<Patron | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  const restoreUserFromToken = useCallback(async () => {
    const generation = getSessionGeneration();
    try {
      let accessToken = await getAccessToken();
      let payload = accessToken ? decodeJwtPayload(accessToken) : null;
      const isExpired = !payload || (payload.exp !== undefined && payload.exp * 1000 < Date.now());

      // Match the web flow: recover a session using its refresh token whenever
      // the access token is missing, malformed, or expired.
      if (isExpired) {
        const refreshToken = await getRefreshToken();
        if (!refreshToken) {
          await clearTokens();
          setUser(null);
          setIsLoading(false);
          return;
        }

        try {
          const result = await authApi.refreshToken(refreshToken);
          accessToken = result.access_token;
          payload = decodeJwtPayload(accessToken);
          if (!payload) throw new Error('Refresh returned an invalid access token');

          await saveSessionTokens(accessToken, result.refresh_token, generation);
        } catch (error: any) {
          if (generation !== getSessionGeneration()) return;
          devError('[Auth] Refresh token failed on restore');
          if (error?.response?.status === 401 || error?.response?.status === 403) await clearTokens();
          setUser(null);
          setPatron(null);
          setIsLoading(false);
          return;
        }
      }

      if (!payload) {
        await clearTokens();
        setUser(null);
        return;
      }

      if (generation !== getSessionGeneration()) return;
      const role = (payload.roles?.[0] || payload.role || 'patron') as UserRole;

      // Set basic user from token immediately
      setUser({
        id: (payload.userId || payload.sub) || '',
        email: payload.email || '',
        full_name: payload.fullName || payload.full_name || '',
        role,
      });

      // Fetch full profile to get avatar_url and other fields not in JWT
      try {
        if (role === 'admin' || role === 'staff') {
          setPatron(null);
          const userData = await authApi.getCurrentUser();
          if (generation !== getSessionGeneration()) return;
          setUser((prev) => prev ? { ...prev, avatar_url: userData.avatar_url || userData.avatarUrl } : null);
        } else {
          const patronData = await authApi.getCurrentPatron();
          if (generation !== getSessionGeneration()) return;
          setPatron(patronData);
          setUser((prev) => prev ? { ...prev, avatar_url: patronData.avatar_url || patronData.avatarUrl } : null);
        }
      } catch {
        devError('[Auth] Failed to fetch profile on restore');
      }
    } catch (err: unknown) {
      devError('[Auth] Failed to restore session:', err);
    } finally {
      setIsLoading(false);
    }
  }, []);

  useEffect(() => {
    restoreUserFromToken();
  }, [restoreUserFromToken]);

  useEffect(() => {
    const unsub = bus.on('auth:expired', () => {
      setUser(null);
      setPatron(null);
      queryClient.clear();
    });
    return () => unsub();
  }, []);

  const patronLogin = async (studentCode: string, password: string) => {
    setIsLoading(true);
    try {
      const response = await authApi.patronLogin({ student_code: studentCode, password });
      setPatron(response.user);
      setUser({ id: response.user.id, email: response.user.email || '', full_name: getFullName(response.user), role: 'patron', avatar_url: response.user.avatar_url || response.user.avatarUrl });
    } finally {
      setIsLoading(false);
    }
  };

  const staffLogin = async (email: string, password: string) => {
    setIsLoading(true);
    try {
      const response = await authApi.login({ email, password });
      const userData = response.user;
      if (!userData || !['admin', 'staff'].includes(userData.role)) {
        await authApi.logout();
        throw new Error('Tài khoản này không có quyền dùng máy quét trả sách');
      }
      setPatron(null);
      setUser({
        id: userData.id,
        email: userData.email || email,
        full_name: getFullName(userData),
        role: userData.role,
        avatar_url: userData.avatar_url || userData.avatarUrl,
      });
    } finally {
      setIsLoading(false);
    }
  };

  const faceLogin = async (imageUri: string) => {
    setIsLoading(true);
    try {
      const tokenRes = await authApi.faceLogin(imageUri);
      const payload = decodeJwtPayload(tokenRes.access_token);
      const role: string = payload?.roles?.[0] || payload?.role || 'patron';

      if (role === 'admin' || role === 'staff') {
        const userData = await authApi.getCurrentUser();
        setPatron(null);
        setUser({ id: userData.id, email: userData.email || '', full_name: getFullName(userData), role: userData.role, avatar_url: userData.avatar_url || userData.avatarUrl });
      } else {
        const patronData = await authApi.getCurrentPatron();
        setPatron(patronData);
        setUser({ id: patronData.id, email: patronData.email || '', full_name: getFullName(patronData), role: 'patron', avatar_url: patronData.avatar_url || patronData.avatarUrl });
      }
    } catch (error) {
      await authApi.logout();
      throw error;
    } finally {
      setIsLoading(false);
    }
  };

  const logout = async () => {
    if (NOTIFS_AVAILABLE) {
      try {
        const tokenData = await Notifications.getExpoPushTokenAsync();
        await notificationApi.unregisterDeviceToken(tokenData.data);
      } catch {}
    }
    cancelPendingRequests();
    // Clear AI widget conversation from RAM so the next user on the same
    // device does not see the previous session's history. (P1-2)
    useAIWidgetStore.getState().clearMessages();
    await authApi.logout();
    queryClient.clear();
    setUser(null);
    setPatron(null);
  };

  const updateUser = (patch: Partial<User>) => {
    setUser((prev) => (prev ? { ...prev, ...patch } : prev));
    setPatron((prev) => (prev ? { ...prev, ...patch } : prev));
  };

  // P2-6: dedicated updater so EditProfileScreen can sync patron-specific
  // fields (phone, permanent_address) that are not part of the User type.
  const updatePatron = (patch: Partial<Patron>) => {
    setPatron((prev) => (prev ? { ...prev, ...patch } : prev));
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        patron,
        isLoading,
        isAuthenticated: !!user,
        staffLogin,
        patronLogin,
        faceLogin,
        logout,
        updateUser,
        updatePatron,
        restoreUserFromToken,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
}
