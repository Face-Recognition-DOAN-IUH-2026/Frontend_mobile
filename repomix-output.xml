            value={manualValue}
            onChangeText={setManualValue}
            placeholder={manualPlaceholder}
            placeholderTextColor={c.custom.textDisabled}
            style={[s.input, { backgroundColor: c.surfaceVariant, color: c.onSurface, borderColor: c.outlineVariant }]}
