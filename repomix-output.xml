        </View>
      </View>
      {book.description && (
        <Text style={[inlineStyles.description, { color: theme.colors.onSurfaceVariant }]} numberOfLines={3}>
          {book.description}
        </Text>
      )}
    </View>
  );
}

const inlineStyles = StyleSheet.create({
