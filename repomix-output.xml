            <Text style={[s.categoryText, { color: c.primary }]}>{recommendation.category}</Text>
          </View>
        ) : null}
        {recommendation.reason ? (
          <Text style={[s.reason, { color: c.onSurfaceVariant }]} numberOfLines={2}>
