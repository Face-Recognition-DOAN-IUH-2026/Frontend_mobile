  };

  const handleImport = async () => {
    if (scannedIsbns.length === 0) return;

    setIsImporting(true);
    try {
      const items = scannedIsbns.map((item) => ({ isbn: item.isbn, quantity: item.quantity }));
      const result = await borrowApi.batchImportByIsbn(items);
      setImportResult(result);
      setShowResult(true);
      if (result.success) {
        setScannedIsbns([]);
      }
    } catch (err: any) {
      const message = err?.response?.data?.detail || err?.message || 'Nhập kho thất bại';
      setSnackbarMsg(message);
      devError('[ImportBooks] import error:', err);
    } finally {
      setIsImporting(false);
    }
  };

  const validCount = scannedIsbns.length;

  const renderCamera = () => (
    <View style={styles.cameraContainer}>
      <CameraView
        style={styles.camera}
        facing="back"
        barcodeScannerSettings={{
          barcodeTypes: ['ean13', 'ean8', 'upc_a', 'upc_e', 'code128', 'code39'],
        }}
        onBarcodeScanned={handleBarCodeScanned}
      />
      <View style={styles.cameraOverlay}>
        <View style={styles.scanArea}>
          <View style={[styles.corner, styles.topLeft]} />
          <View style={[styles.corner, styles.topRight]} />
          <View style={[styles.corner, styles.bottomLeft]} />
          <View style={[styles.corner, styles.bottomRight]} />
        </View>
        <Text style={styles.scanText}>Đặt mã vạch trong khung hình</Text>
      </View>
      <Surface style={styles.manualInput} elevation={0}>
        <View style={styles.manualAccent} />
        <TextInput
          label="Nhập ISBN thủ công"
          value={manualIsbn}
          onChangeText={setManualIsbn}
          mode="outlined"
          style={styles.manualInputField}
          outlineStyle={styles.inputOutline}
          activeOutlineColor={c.primary}
          disabled={isManualSearching}
          right={
            <TextInput.Icon
              icon="plus"
              onPress={handleManualAdd}
              disabled={isManualSearching || !manualIsbn.trim()}
              color={c.primary}
            />
          }
        />
      </Surface>
    </View>
  );

  const renderScannedList = () => {
    if (scannedIsbns.length === 0) {
      return (
        <View style={styles.emptyState}>
          <MaterialCommunityIcons name="barcode-scan" size={48} color={c.onSurfaceVariant} />
          <Text variant="bodyLarge" style={styles.emptyText}>Quét mã ISBN để bắt đầu</Text>
          <Text variant="bodySmall" style={styles.emptyHint}>
            Camera sẽ tự động nhận diện mã vạch
          </Text>
        </View>
      );
    }

    return (
      <ScrollView style={styles.listContainer} contentContainerStyle={styles.listContent}>
        {scannedIsbns.map((item) => (
          <Card key={item.isbn} mode="outlined" style={styles.itemCard}>
            <Card.Content style={styles.itemContent}>
              {item.lookup?.cover_url ? (
                <Image source={{ uri: item.lookup.cover_url }} style={styles.itemCover} />
              ) : (
                <View style={styles.itemCoverPlaceholder}>
                  <MaterialCommunityIcons name="book-variant" size={24} color={c.onSurfaceVariant} />
                </View>
              )}
              <View style={styles.itemInfo}>
                <View style={styles.itemHeader}>
                  {item.loading ? (
                    <ActivityIndicator size="small" color={c.primary} />
                  ) : item.error ? (
                    <View style={styles.errorRow}>
                      <MaterialCommunityIcons name="alert-circle-outline" size={16} color={c.error} />
                      <Text variant="bodySmall" style={styles.errorText}>{item.error}</Text>
                    </View>
                  ) : (
                    <>
                      <Text variant="titleSmall" style={styles.itemTitle} numberOfLines={2}>
                        {item.lookup?.title || 'Đang tải...'}
                      </Text>
                      {item.lookup ? (
                        <Chip
                          compact
                          style={item.lookup.total_copies > 0 ? styles.existsChip : styles.newChip}
                          textStyle={item.lookup.total_copies > 0 ? styles.existsChipText : styles.newChipText}
                        >
                          {item.lookup.total_copies > 0 ? 'Đã có' : 'Mới'}
                        </Chip>
                      ) : null}
                    </>
                  )}
                </View>

                {!item.loading && item.lookup ? (
                  <>
                    {item.lookup.author ? (
                      <Text variant="bodySmall" style={styles.itemAuthor} numberOfLines={1}>
                        {item.lookup.author}
                      </Text>
                    ) : null}
                    {item.lookup.publisher || item.lookup.published_date ? (
                      <Text variant="bodySmall" style={styles.itemMeta} numberOfLines={1}>
                        {[item.lookup.publisher, item.lookup.published_date?.slice(0, 4)].filter(Boolean).join(' - ')}
                      </Text>
                    ) : null}
                    {item.lookup.page_count ? (
                      <Text variant="bodySmall" style={styles.itemMeta}>
                        {item.lookup.page_count} trang
                      </Text>
                    ) : null}
                    <Text variant="bodySmall" style={styles.itemIsbn}>ISBN: {item.isbn}</Text>
                    {item.lookup.total_copies > 0 ? (
                      <Text variant="bodySmall" style={styles.itemStock}>
                        Kho: {item.lookup.total_copies} / Sẵn: {item.lookup.available_copies}
                        {item.quantity > 0 ? (
                          <Text variant="bodySmall" style={styles.itemProjected}>
                            {' '}→ Sau nhập: {item.lookup.total_copies + item.quantity}
                          </Text>
                        ) : null}
                      </Text>
                    ) : null}
                  </>
                ) : !item.loading && !item.lookup ? (
                  <Text variant="bodySmall" style={styles.itemIsbn}>{item.isbn}</Text>
                ) : null}

                {!item.loading ? (
                  <View style={styles.quantityRow}>
                    <IconButton
                      icon="minus"
                      size={16}
                      mode="contained-tonal"
                      onPress={() => changeQuantity(item.isbn, -1)}
                      style={styles.qtyBtn}
                    />
                    <Text variant="titleMedium" style={styles.qtyValue}>{item.quantity}</Text>
                    <IconButton
                      icon="plus"
                      size={16}
                      mode="contained-tonal"
                      onPress={() => changeQuantity(item.isbn, 1)}
                      style={styles.qtyBtn}
                    />
                    <View style={styles.qtySpacer} />
                    <IconButton
                      icon="delete-outline"
                      size={18}
                      onPress={() => removeItem(item.isbn)}
                      iconColor={c.error}
                    />
                  </View>
                ) : null}
              </View>
            </Card.Content>
          </Card>
        ))}
      </ScrollView>
    );
  };

  if (!permission) {
    return (
      <SafeAreaView style={styles.container}>
        <ActivityIndicator color={c.primary} />
      </SafeAreaView>
    );
  }

  if (!permission.granted) {
    return (
      <SafeAreaView style={styles.permissionContainer}>
        <Text style={styles.permissionText}>Cần quyền camera để quét mã vạch</Text>
        <Button mode="contained" onPress={requestPermission} style={styles.permissionButton}>
          Cấp quyền
        </Button>
        <View style={styles.dividerRow}>
          <View style={styles.dividerLine} />
          <Text style={styles.orText}>hoặc</Text>
          <View style={styles.dividerLine} />
        </View>
        <TextInput
          label="Nhập ISBN"
          value={manualIsbn}
          onChangeText={setManualIsbn}
          mode="outlined"
          style={styles.isbnInput}
          outlineStyle={styles.inputOutline}
          activeOutlineColor={c.primary}
          right={
            <TextInput.Icon
              icon="plus"
              onPress={handleManualAdd}
              disabled={isManualSearching || !manualIsbn.trim()}
              color={c.primary}
            />
          }
        />
        {scannedIsbns.length > 0 ? (
          <View style={styles.offlineListContainer}>
            <Text variant="titleSmall" style={styles.offlineListTitle}>
              Đã quét ({scannedIsbns.length} cuốn)
            </Text>
            {renderScannedList()}
          </View>
        ) : null}
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.container} edges={['bottom']}>
      {renderCamera()}

      <View style={styles.listSection}>
        <View style={styles.listSectionHeader}>
          <Text variant="titleSmall" style={styles.listSectionTitle}>
            Đã quét ({scannedIsbns.length} cuốn)
          </Text>
          {scannedIsbns.length > 0 ? (
            <Button compact onPress={() => setScannedIsbns([])} textColor={c.error}>
              Xoá tất cả
            </Button>
          ) : null}
        </View>
        {renderScannedList()}
      </View>

      <Surface style={styles.bottomBar} elevation={2}>
        <View style={styles.bottomBarContent}>
          <View>
            <Text variant="bodySmall" style={styles.bottomBarCount}>
              {scannedIsbns.length} cuốn đã quét
            </Text>
            {validCount > 0 ? (
              <Text variant="bodySmall" style={styles.bottomBarValid}>
                {validCount} cuốn
              </Text>
            ) : null}
          </View>
          <Button
            mode="contained"
            onPress={handleImport}
            loading={isImporting}
            disabled={isImporting || validCount === 0}
            icon="package-variant-closed"
          >
            Nhập vào kho ({validCount})
          </Button>
        </View>
      </Surface>

      <Portal>
        <Dialog visible={showResult} onDismiss={() => setShowResult(false)}>
          <Dialog.Icon icon="checkbox-marked-circle-outline" />
          <Dialog.Title style={styles.dialogTitle}>
            Kết quả nhập kho
          </Dialog.Title>
          <Dialog.Content>
            {importResult ? (
              <>
                <View style={styles.resultStats}>
                  <View style={styles.resultStat}>
                    <Text variant="headlineMedium" style={styles.resultStatValue}>{importResult.imported}</Text>
                    <Text variant="bodySmall" style={styles.resultStatLabel}>Thành công</Text>
                  </View>
                  <View style={styles.resultStat}>
                    <Text variant="headlineMedium" style={[styles.resultStatValue, importResult.skipped > 0 && { color: c.custom.warning }]}>{importResult.skipped}</Text>
                    <Text variant="bodySmall" style={styles.resultStatLabel}>Bỏ qua</Text>
                  </View>
                  <View style={styles.resultStat}>
                    <Text variant="headlineMedium" style={[styles.resultStatValue, importResult.errors > 0 && { color: c.error }]}>{importResult.errors}</Text>
                    <Text variant="bodySmall" style={styles.resultStatLabel}>Lỗi</Text>
                  </View>
                </View>
                <Divider style={styles.resultDivider} />
                <ScrollView style={styles.resultList}>
                  {importResult.results.map((row, idx) => (
                    <View key={idx} style={styles.resultRow}>
                      <View style={{ flex: 1, gap: 2 }}>
                        <Text variant="bodySmall" style={styles.resultRowIsbn}>{row.isbn}</Text>
                        <Text variant="bodySmall" style={styles.resultRowTitle} numberOfLines={1}>{row.title}</Text>
                        {row.quantity > 0 ? (
                          <Text style={{ color: c.custom.textDisabled, fontSize: 10 }}>
                            SL: {row.quantity} | Mã vạch: {row.barcodes?.length || 0}
                          </Text>
                        ) : null}
                        {row.message ? (
                          <Text style={{ color: c.custom.textDisabled, fontSize: 10 }} numberOfLines={1}>
                            {row.message}
                          </Text>
                        ) : null}
                      </View>
                      <Chip
                        compact
                        style={row.status === 'imported' || row.status === 'updated' ? styles.resultSuccessChip : row.status === 'warning' ? styles.resultWarningChip : styles.resultErrorChip}
                        textStyle={row.status === 'imported' || row.status === 'updated' ? styles.resultSuccessChipText : row.status === 'warning' ? styles.resultWarningChipText : styles.resultErrorChipText}
                      >
                        {statusLabels[row.status] || row.status}
                      </Chip>
                    </View>
                  ))}
                </ScrollView>
              </>
            ) : null}
          </Dialog.Content>
          <Dialog.Actions>
            <Button onPress={() => setShowResult(false)}>Đóng</Button>
          </Dialog.Actions>
        </Dialog>
      </Portal>

      <NoticeSnackbar
        visible={!!snackbarMsg}
        message={snackbarMsg || ''}
        severity={snackbarMsg?.includes('Không tìm thấy') ? 'error' : 'info'}
        onDismiss={() => setSnackbarMsg(null)}
      />
    </SafeAreaView>
  );
}
</file>

<file path="src/features/notifications/screens/NotificationScreen.tsx">
import MaterialCommunityIcons from '@expo/vector-icons/MaterialCommunityIcons';
import { useFocusEffect } from '@react-navigation/native';
import React, { useCallback, useMemo, useState } from 'react';
import { FlatList, RefreshControl, StyleSheet, TouchableOpacity, View } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Surface, Text, useTheme } from 'react-native-paper';
import { GradientHeader, EmptyState, FilterPill } from '../../../theme/MobileDesignSystem';
import { useNotification } from '../../../context/NotificationContext';
import { AppTheme } from '../../../theme/DarkTheme';
import { Notification } from '../../../types';
import { formatRelativeTime } from '../../../utils/dateUtils';
import { LoadingOverlay } from '../../../components/LoadingOverlay';

interface NotificationScreenProps {
  navigation: any;
}

type FilterTab = 'all' | 'unread';

interface ExpandedState {
  [key: string]: boolean;
}

const FILTERS: { key: FilterTab; label: string }[] = [
  { key: 'all', label: 'Tất cả' },
  { key: 'unread', label: 'Chưa đọc' },
];

const NOTIFICATION_ICONS: Record<string, { name: React.ComponentProps<typeof MaterialCommunityIcons>['name']; colorKey: 'error' | 'success' | 'warning' | 'primary' }> = {
  borrow_overdue: { name: 'alert-circle', colorKey: 'error' },
  book_available: { name: 'book-check', colorKey: 'success' },
  schedule_change: { name: 'calendar-clock', colorKey: 'warning' },
  membership_expiry: { name: 'card-account-details', colorKey: 'primary' },
  access_anomaly: { name: 'shield-alert', colorKey: 'error' },
  daily_stats: { name: 'chart-bar', colorKey: 'primary' },
  staff_absence: { name: 'account-off', colorKey: 'warning' },
};

function getNotificationIcon(type: string) {
  return NOTIFICATION_ICONS[type] || { name: 'bell' as const, colorKey: 'primary' as const };
}

function getSpineColor(type: string, colors: any): string {
  const icon = getNotificationIcon(type);
  if (icon.colorKey === 'error') return colors.error;
  if (icon.colorKey === 'success') return colors.custom.success;
  if (icon.colorKey === 'warning') return colors.custom.warning;
  return colors.primary;
}

function getIconBgColor(type: string, colors: any): string {
  const icon = getNotificationIcon(type);
  if (icon.colorKey === 'error') return colors.error;
  if (icon.colorKey === 'success') return colors.custom.success;
  if (icon.colorKey === 'warning') return colors.custom.warning;
  return colors.primary;
}

export default function NotificationScreen({ navigation }: NotificationScreenProps) {
  const theme = useTheme() as AppTheme;
  const c = theme.colors;
  const styles = useMemo(() => createStyles(theme), [theme]);
  const { notifications, unreadCount, isLoading, fetchNotifications, markAsRead, markAllAsRead } = useNotification();
  const [activeFilter, setActiveFilter] = useState<FilterTab>('all');
  const [refreshing, setRefreshing] = useState(false);
  const [expanded, setExpanded] = useState<ExpandedState>({});

  useFocusEffect(
    useCallback(() => {
      fetchNotifications();
    }, [fetchNotifications])
  );

  const onRefresh = async () => {
    setRefreshing(true);
    await fetchNotifications();
    setRefreshing(false);
  };

  const filtered = notifications.filter((n) => {
    if (activeFilter === 'unread') return !n.isRead;
    return true;
  });

  const handlePress = async (item: Notification) => {
    if (!item.isRead) {
      await markAsRead(item.id);
    }
    navigation.navigate('NotificationDetail', { notification: { ...item, isRead: true } });
  };

  const toggleExpand = (id: string) => {
    setExpanded((prev) => ({ ...prev, [id]: !prev[id] }));
  };

  const renderItem = ({ item }: { item: Notification }) => {
    const icon = getNotificationIcon(item.type);
    const spineColor = getSpineColor(item.type, c);
    const iconBg = getIconBgColor(item.type, c);

    return (
      <TouchableOpacity activeOpacity={0.7} onPress={() => handlePress(item)}>
        <Surface style={[styles.card, { backgroundColor: c.surface, borderColor: c.outline }]} elevation={0}>
          <View style={[styles.spine, { backgroundColor: item.isRead ? c.custom.textDisabled : spineColor }]} />
          <View style={[styles.iconCircle, { backgroundColor: `${iconBg}20` }]}>
            <MaterialCommunityIcons name={icon.name} size={20} color={item.isRead ? c.custom.textDisabled : iconBg} />
          </View>
          <View style={styles.content}>
            <Text style={[styles.title, { color: item.isRead ? c.onSurfaceVariant : c.onSurface }]} numberOfLines={1}>
              {item.title}
            </Text>
            <Text style={[styles.body, { color: c.onSurfaceVariant }]} numberOfLines={expanded[item.id] ? undefined : 2}>
              {item.body}
            </Text>
            {item.body && item.body.length > 100 ? (
              <TouchableOpacity onPress={() => toggleExpand(item.id)} style={styles.expandBtn}>
                <Text style={[styles.expandText, { color: c.primary }]}>
                  {expanded[item.id] ? 'Thu gọn' : 'Xem thêm'}
                </Text>
              </TouchableOpacity>
            ) : null}
            <Text style={[styles.time, { color: c.custom.textDisabled }]}>
              {formatRelativeTime(item.createdAt)}
            </Text>
          </View>
        </Surface>
      </TouchableOpacity>
    );
  };

  return (
    <SafeAreaView style={[styles.container, { backgroundColor: c.background }]} edges={['bottom']}>
      <GradientHeader
        title="Thông báo"
        subtitle={unreadCount > 0 ? `${unreadCount} chưa đọc` : 'Không có thông báo mới'}
        icon="bell"
        right={
          unreadCount > 0 ? (
            <TouchableOpacity activeOpacity={0.7} onPress={markAllAsRead} style={styles.markAllBtn}>
              <MaterialCommunityIcons name="check-all" size={18} color="#e0e7ff" />
              <Text style={[styles.markAllText, { color: "#e0e7ff" }]}>Đọc tất cả</Text>
            </TouchableOpacity>
          ) : null
        }
      />

      <View style={styles.filterRow}>
        {FILTERS.map((f) => (
          <FilterPill key={f.key} label={f.label} active={activeFilter === f.key} onPress={() => setActiveFilter(f.key)} />
        ))}
      </View>

      {isLoading && !refreshing ? <LoadingOverlay loading message="Đang tải..." /> : (
        <FlatList
          data={filtered}
          keyExtractor={(item) => item.id}
          renderItem={renderItem}
          refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}
          contentContainerStyle={styles.listContent}
          ListEmptyComponent={
            <EmptyState
              icon="bell-outline"
              title={activeFilter === 'unread' ? 'Không có thông báo chưa đọc' : 'Không có thông báo mới'}
            />
          }
        />
      )}
    </SafeAreaView>
  );
}

function createStyles(theme: AppTheme) {
  return StyleSheet.create({
    container: { flex: 1 },
    markAllBtn: {
      flexDirection: 'row',
      alignItems: 'center',
      gap: 4,
      paddingHorizontal: 10,
      paddingVertical: 5,
      borderRadius: 8,
      borderWidth: 0.5,
      borderColor: 'rgba(255,255,255,0.3)',
    },
    markAllText: { fontSize: 12, fontWeight: '600' },
    filterRow: {
      flexDirection: 'row',
      paddingHorizontal: 16,
      paddingTop: 14,
      paddingBottom: 6,
      gap: 8,
    },
    listContent: {
      paddingBottom: 20,
    },
    card: {
      marginHorizontal: 16,
      marginTop: 10,
      borderRadius: 10,
      flexDirection: 'row',
      overflow: 'hidden',
      borderWidth: 0.5,
    },
    spine: { width: 4 },
    iconCircle: {
      width: 36,
      height: 36,
      borderRadius: 18,
      alignItems: 'center',
      justifyContent: 'center',
      margin: 10,
      marginRight: 0,
    },
    content: { flex: 1, padding: 10, paddingRight: 14 },
    title: { fontWeight: '600', fontSize: 14, lineHeight: 18 },
    body: { fontSize: 12, marginTop: 2, lineHeight: 16 },
    expandBtn: { marginTop: 4 },
    expandText: { fontSize: 12, fontWeight: '600' },
    time: { fontSize: 11, marginTop: 4 },
  });
}
</file>

<file path="src/features/profile/screens/ProfileScreen.tsx">
import React, { useMemo, useState } from 'react';
import { ScrollView, StyleSheet, View, TouchableOpacity, Alert } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import {
  Avatar,
  Button,
  Dialog,
  Divider,
  List,
  Portal,
  Switch,
  Text,
  ActivityIndicator,
  useTheme,
} from 'react-native-paper';
import MaterialCommunityIcons from '@expo/vector-icons/MaterialCommunityIcons';
import * as ImagePicker from 'expo-image-picker';

import { useAuth } from '../../../context/AuthContext';
import { useMobileTheme } from '../../../context/ThemeContext';
import { AppTheme } from '../../../theme/DarkTheme';
import { authApi } from '../../../api/auth';
import { GradientHeader, SectionCard } from '../../../theme/MobileDesignSystem';
import { LoadingOverlay } from '../../../components/LoadingOverlay';

interface ProfileScreenProps {
  navigation: any;
}

function InfoField({ icon, label, value, theme }: { icon: string; label: string; value: string; theme: AppTheme }) {
  return (
    <View style={infoStyles.row}>
      <View style={[infoStyles.iconWrap, { backgroundColor: theme.colors.primary + '15' }]}>
        <MaterialCommunityIcons name={icon as any} size={16} color={theme.colors.primary} />
      </View>
      <View style={infoStyles.textWrap}>
        <Text style={[infoStyles.label, { color: theme.colors.onSurfaceVariant }]}>{label}</Text>
        <Text style={[infoStyles.value, { color: theme.colors.onSurface }]} selectable numberOfLines={2}>
          {value}
        </Text>
      </View>
    </View>
  );
}

const infoStyles = StyleSheet.create({
  row: {
    flexDirection: 'row',
    alignItems: 'flex-start',
    gap: 10,
  },
  iconWrap: {
    width: 32,
    height: 32,
    borderRadius: 10,
    alignItems: 'center',
    justifyContent: 'center',
  },
  textWrap: {
    flex: 1,
    gap: 2,
  },
  label: {
    fontSize: 11,
    fontWeight: '700',
    textTransform: 'uppercase',
    letterSpacing: 0.5,
  },
  value: {
    fontSize: 14,
    fontWeight: '600',
  },
});

export default function ProfileScreen({ navigation }: ProfileScreenProps) {
  const theme = useTheme() as AppTheme;
  const styles = useMemo(() => createStyles(theme), [theme]);
  const { user, patron, logout, updateUser } = useAuth();
  const { mode, toggleTheme } = useMobileTheme();
  const [logoutVisible, setLogoutVisible] = useState(false);
  const [uploading, setUploading] = useState(false);

  const roleLabel =
    user?.role === 'admin'
      ? 'Quản trị viên'
      : user?.role === 'staff'
        ? 'Nhân viên'
        : 'Độc giả';

  const isStaffScanner = user?.role === 'admin' || user?.role === 'staff';

  const displayName = user?.full_name || 'Người dùng';

  const handleLogout = async () => {
    setLogoutVisible(false);
    await logout();
  };

  const handlePickAvatar = async () => {
    const permissionResult = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (!permissionResult.granted) {
      Alert.alert('Quyền truy cập', 'Ứng dụng cần quyền truy cập thư viện ảnh để bạn có thể đổi ảnh đại diện.');
      return;
    }

    const result = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ['images'],
      allowsEditing: true,
      aspect: [1, 1],
      quality: 0.8,
    });

    if (!result.canceled && result.assets[0]) {
      setUploading(true);
      try {
        const { avatarUrl } = await authApi.uploadAvatar(result.assets[0].uri);
        if (user) {
          await updateUser({ avatar_url: avatarUrl });
        }
        Alert.alert('Thành công', 'Đổi ảnh đại diện thành công!');
      } catch (error) {
        Alert.alert('Lỗi', 'Không thể cập nhật ảnh. Vui lòng thử lại.');
      } finally {
        setUploading(false);
      }
    }
  };

  const studentFields = [
    { icon: 'card-account-details', label: 'MSSV', value: patron?.student_code || patron?.studentCode || '—' },
    { icon: 'account-school', label: 'Lớp', value: patron?.class_name || patron?.className || '—' },
    { icon: 'bookmark-outline', label: 'Khóa học', value: patron?.course || '—' },
    { icon: 'domain', label: 'Khoa', value: patron?.faculty || '—' },
    { icon: 'cake-variant-outline', label: 'Ngày sinh', value: patron?.date_of_birth || patron?.dateOfBirth || '—' },
    { icon: 'home-outline', label: 'HKTT', value: patron?.permanent_address || patron?.permanentAddress || '—' },
    { icon: 'card-bulleted-outline', label: 'CCCD', value: patron?.identity_number || '—' },
    { icon: 'badge-account', label: 'Số thẻ TV', value: patron?.card_number || patron?.cardNumber || '—' },
    { icon: 'calendar-plus', label: 'Ngày cấp thẻ', value: patron?.issue_date || patron?.issueDate || '—' },
    { icon: 'calendar-clock', label: 'Hạn thẻ', value: patron?.membership_expiry || patron?.membershipExpiry || '—' },
    { icon: 'card-account-phone', label: 'Số điện thoại', value: patron?.phone || '—' },
  ];

  const studentCode = patron?.student_code || patron?.studentCode;
  const isStudent = user?.role === 'patron' && !!studentCode;

  return (
    <SafeAreaView style={styles.container} edges={['bottom']}>
      <LoadingOverlay loading={!user} message="Đang tải hồ sơ...">
        <ScrollView style={styles.flex} contentContainerStyle={styles.content}>
          <GradientHeader
            title={displayName}
            subtitle={user?.email}
            icon="account-circle"
            right={
              <TouchableOpacity onPress={handlePickAvatar} disabled={uploading} activeOpacity={0.7}>
                <View style={styles.avatarWrapper}>
                  {user?.avatar_url ? (
                    <Avatar.Image size={48} source={{ uri: user.avatar_url }} style={styles.avatar} />
                  ) : (
                    <Avatar.Text size={48} label={(displayName || user?.email || 'U').slice(0, 1).toUpperCase()} color="#FFFFFF" style={styles.avatar} />
                  )}
                  {uploading ? (
                    <View style={styles.avatarOverlay}>
                      <ActivityIndicator size="small" color="#fff" />
                    </View>
