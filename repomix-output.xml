          right={
            user?.avatar_url ? (
              <Avatar.Image size={40} source={{ uri: user.avatar_url }} />
            ) : (
              <Avatar.Text size={40} label={displayName.slice(0, 1).toUpperCase()} color={theme.colors.onPrimary} style={{ backgroundColor: 'rgba(255,255,255,0.2)' }} />
