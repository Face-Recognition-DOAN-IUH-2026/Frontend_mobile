      borderRadius: 16,
      borderWidth: 0.5,
    },
    filterText: { fontSize: 13, fontWeight: '600' },
    stateCard: {
      marginHorizontal: 16,
      marginTop: 24,
      padding: 32,
      borderRadius: 10,
      alignItems: 'center',
      borderWidth: 0.5,
    },
    stateText: { marginTop: 12, marginBottom: 16, textAlign: 'center' },
    stateButton: { borderRadius: 6 },
    stateButtonLabel: { fontSize: 14 },
    recordCard: {
      marginHorizontal: 16,
      marginTop: 10,
      borderRadius: 10,
      flexDirection: 'row',
      overflow: 'hidden',
      borderWidth: 0.5,
    },
    recordSpine: { width: 4 },
    bookCover: {
      width: 48,
      height: 66,
      borderRadius: 4,
      margin: 10,
      marginRight: 0,
    },
    bookCoverPlaceholder: {
      width: 48,
      height: 66,
      borderRadius: 4,
      margin: 10,
      marginRight: 0,
      alignItems: 'center',
      justifyContent: 'center',
    },
    recordContent: { flex: 1, padding: 10 },
    bookTitle: { fontWeight: '600', fontSize: 14, lineHeight: 18 },
    bookAuthor: { fontSize: 12, marginTop: 1 },
    recordMeta: { marginTop: 6, gap: 1 },
    metaText: { fontSize: 11 },
