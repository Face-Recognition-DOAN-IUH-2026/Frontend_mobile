  amber: ['#f59e0b', '#d97706'],
  blue: ['#3b82f6', '#1d4ed8'],
  red: ['#ef4444', '#dc2626'],
  violet: ['#8b5cf6', '#6d28d9'],
  cyan: ['#06b6d4', '#0891b2'],
  rose: ['#f43f5e', '#e11d48'],
};

const dhStyles = StyleSheet.create({
  header: {
    borderRadius: 16,
    padding: 20,
    position: 'relative',
    overflow: 'hidden',
  },
  circle: {
    position: 'absolute',
    borderRadius: 999,
  },
  headerRow: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 14,
    zIndex: 1,
  },
  headerAvatar: {
  },
  headerTitle: {
    fontWeight: '800',
  },
  headerSubtitle: {
    marginTop: 2,
  },

