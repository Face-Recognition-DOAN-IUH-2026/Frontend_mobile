      fontWeight: '700',
    },
  }), [c]);

  const [permission, requestPermission] = useCameraPermissions();
  const [scannedIsbns, setScannedIsbns] = useState<ScannedItem[]>([]);
  const [isImporting, setIsImporting] = useState(false);
  const [showResult, setShowResult] = useState(false);
  const [importResult, setImportResult] = useState<BookImportResponse | null>(null);
  const [snackbarMsg, setSnackbarMsg] = useState<string | null>(null);
  const [manualIsbn, setManualIsbn] = useState('');
  const [isManualSearching, setIsManualSearching] = useState(false);
  const lastScannedRef = useRef<{ isbn: string; time: number } | null>(null);

  const addScanned = useCallback(async (isbn: string) => {
    const cleanIsbn = isbn.replace(/[-\s]/g, '');
    if (!/^\d{10,13}$/.test(cleanIsbn)) return;

    setScannedIsbns((prev) => {
      const existing = prev.find((item) => item.isbn === cleanIsbn);
      if (existing) {
        return prev.map((item) =>
          item.isbn === cleanIsbn ? { ...item, quantity: item.quantity + 1 } : item,
        );
      }
      return [...prev, { isbn: cleanIsbn, quantity: 1, lookup: null, loading: true, error: null }];
    });

    try {
      const lookup = await borrowApi.lookupBookByIsbn(cleanIsbn);
      setScannedIsbns((prev) =>
        prev.map((item) =>
          item.isbn === cleanIsbn ? { ...item, lookup, loading: false } : item,
        ),
      );
    } catch (err: any) {
      setScannedIsbns((prev) => prev.filter((item) => item.isbn !== cleanIsbn));
      const message = err?.response?.data?.detail || err?.message || 'Không tìm thấy sách';
      setSnackbarMsg(`Không tìm thấy sách: ${cleanIsbn}`);
      devError('[ImportBooks] lookup error:', err);
    }
  }, []);

  const handleBarCodeScanned = (result: BarcodeScanningResult) => {
    const isbn = result.data?.trim();
    if (!isbn) return;

    const cleanIsbn = isbn.replace(/[-\s]/g, '');
    if (!/^\d{10,13}$/.test(cleanIsbn)) return;

    const now = Date.now();
    if (lastScannedRef.current && lastScannedRef.current.isbn === cleanIsbn && now - lastScannedRef.current.time < 2000) {
      return;
    }

    lastScannedRef.current = { isbn: cleanIsbn, time: now };
    setSnackbarMsg(`Đã quét ISBN: ${isbn}`);
    addScanned(cleanIsbn);
  };

  const handleManualAdd = async () => {
    const isbn = manualIsbn.trim();
    if (!isbn) return;
    setIsManualSearching(true);
    await addScanned(isbn);
    setIsManualSearching(false);
    setManualIsbn('');
  };

  const changeQuantity = (isbn: string, delta: number) => {
    setScannedIsbns((prev) =>
      prev.map((item) => {
        if (item.isbn !== isbn) return item;
        const next = item.quantity + delta;
        return { ...item, quantity: next < 1 ? 1 : next };
      }),
    );
  };

  const removeItem = (isbn: string) => {
    setScannedIsbns((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const handleImport = async () => {
    const validItems = scannedIsbns.filter((item) => item.lookup && !item.error);
    if (validItems.length === 0) return;

    setIsImporting(true);
    try {
      const items = validItems.map((item) => ({ isbn: item.isbn, quantity: item.quantity }));
      const result = await borrowApi.batchImportByIsbn(items);
      setImportResult(result);
      setShowResult(true);
      if (result.success) {
        setScannedIsbns([]);
      }
    } catch (err: any) {
      const message = err?.response?.data?.detail || err?.message || 'Nhập kho thất bại';
      setSnackbarMsg(message);
      devError('[ImportBooks] import error:', err);
    } finally {
      setIsImporting(false);
    }
  };

  const validCount = scannedIsbns.filter((item) => item.lookup && !item.error).length;

  const renderCamera = () => (
    <View style={styles.cameraContainer}>
      <CameraView
        style={styles.camera}
        facing="back"
        barcodeScannerSettings={{
          barcodeTypes: ['ean13', 'ean8', 'upc_a', 'upc_e', 'code128', 'code39'],
        }}
        onBarcodeScanned={handleBarCodeScanned}
      />
      <View style={styles.cameraOverlay}>
        <View style={styles.scanArea}>
          <View style={[styles.corner, styles.topLeft]} />
          <View style={[styles.corner, styles.topRight]} />
          <View style={[styles.corner, styles.bottomLeft]} />
          <View style={[styles.corner, styles.bottomRight]} />
        </View>
        <Text style={styles.scanText}>Đặt mã vạch trong khung hình</Text>
      </View>
      <Surface style={styles.manualInput} elevation={0}>
        <View style={styles.manualAccent} />
        <TextInput
          label="Nhập ISBN thủ công"
          value={manualIsbn}
          onChangeText={setManualIsbn}
          mode="outlined"
          style={styles.manualInputField}
          outlineStyle={styles.inputOutline}
          activeOutlineColor={c.primary}
          disabled={isManualSearching}
          right={
            <TextInput.Icon
              icon="plus"
              onPress={handleManualAdd}
              disabled={isManualSearching || !manualIsbn.trim()}
              color={c.primary}
            />
          }
        />
      </Surface>
    </View>
  );

  const renderScannedList = () => {
    if (scannedIsbns.length === 0) {
      return (
        <View style={styles.emptyState}>
          <MaterialCommunityIcons name="barcode-scan" size={48} color={c.onSurfaceVariant} />
          <Text variant="bodyLarge" style={styles.emptyText}>Quét mã ISBN để bắt đầu</Text>
          <Text variant="bodySmall" style={styles.emptyHint}>
            Camera sẽ tự động nhận diện mã vạch
          </Text>
        </View>
      );
    }

    return (
      <ScrollView style={styles.listContainer} contentContainerStyle={styles.listContent}>
        {scannedIsbns.map((item) => (
          <Card key={item.isbn} mode="outlined" style={styles.itemCard}>
            <Card.Content style={styles.itemContent}>
              {item.lookup?.cover_url ? (
                <Image source={{ uri: item.lookup.cover_url }} style={styles.itemCover} />
              ) : (
                <View style={styles.itemCoverPlaceholder}>
                  <MaterialCommunityIcons name="book-variant" size={24} color={c.onSurfaceVariant} />
                </View>
              )}
              <View style={styles.itemInfo}>
                <View style={styles.itemHeader}>
                  {item.loading ? (
                    <ActivityIndicator size="small" color={c.primary} />
                  ) : item.error ? (
                    <View style={styles.errorRow}>
                      <MaterialCommunityIcons name="alert-circle-outline" size={16} color={c.error} />
                      <Text variant="bodySmall" style={styles.errorText}>{item.error}</Text>
                    </View>
                  ) : (
                    <>
                      <Text variant="titleSmall" style={styles.itemTitle} numberOfLines={2}>
                        {item.lookup?.title || 'Đang tải...'}
                      </Text>
                      {item.lookup && (
                        <Chip
                          compact
                          style={item.lookup.total_copies > 0 ? styles.existsChip : styles.newChip}
                          textStyle={item.lookup.total_copies > 0 ? styles.existsChipText : styles.newChipText}
                        >
                          {item.lookup.total_copies > 0 ? 'Đã có' : 'Mới'}
                        </Chip>
                      )}
                    </>
                  )}
                </View>

                {!item.loading && !item.error && item.lookup && (
                  <>
                    {item.lookup.author && (
                      <Text variant="bodySmall" style={styles.itemAuthor} numberOfLines={1}>
                        {item.lookup.author}
                      </Text>
                    )}
                    <Text variant="bodySmall" style={styles.itemIsbn}>{item.isbn}</Text>
                    {item.lookup.total_copies > 0 && (
                      <Text variant="bodySmall" style={styles.itemStock}>
                        Kho: {item.lookup.total_copies} / Sẵn: {item.lookup.available_copies}
                        {item.quantity > 0 && (
                          <Text variant="bodySmall" style={styles.itemProjected}>
                            {' '}→ Sau nhập: {item.lookup.total_copies + item.quantity}
                          </Text>
                        )}
                      </Text>
                    )}
                  </>
                )}

                {!item.loading && !item.error && (
                  <View style={styles.quantityRow}>
                    <IconButton
                      icon="minus"
                      size={16}
                      mode="contained-tonal"
                      onPress={() => changeQuantity(item.isbn, -1)}
                      style={styles.qtyBtn}
                    />
                    <Text variant="titleMedium" style={styles.qtyValue}>{item.quantity}</Text>
                    <IconButton
                      icon="plus"
                      size={16}
                      mode="contained-tonal"
                      onPress={() => changeQuantity(item.isbn, 1)}
                      style={styles.qtyBtn}
                    />
                    <View style={styles.qtySpacer} />
                    <IconButton
                      icon="delete-outline"
                      size={18}
                      onPress={() => removeItem(item.isbn)}
                      iconColor={c.error}
                    />
                  </View>
                )}
              </View>
            </Card.Content>
          </Card>
        ))}
      </ScrollView>
    );
  };

  if (!permission) {
    return (
      <SafeAreaView style={styles.container}>
        <ActivityIndicator color={c.primary} />
      </SafeAreaView>
    );
  }

  if (!permission.granted) {
    return (
      <SafeAreaView style={styles.permissionContainer}>
        <Text style={styles.permissionText}>Cần quyền camera để quét mã vạch</Text>
        <Button mode="contained" onPress={requestPermission} style={styles.permissionButton}>
          Cấp quyền
        </Button>
        <View style={styles.dividerRow}>
          <View style={styles.dividerLine} />
          <Text style={styles.orText}>hoặc</Text>
          <View style={styles.dividerLine} />
        </View>
        <TextInput
          label="Nhập ISBN"
          value={manualIsbn}
          onChangeText={setManualIsbn}
          mode="outlined"
          style={styles.isbnInput}
          outlineStyle={styles.inputOutline}
          activeOutlineColor={c.primary}
          right={
            <TextInput.Icon
              icon="plus"
              onPress={handleManualAdd}
              disabled={isManualSearching || !manualIsbn.trim()}
              color={c.primary}
            />
          }
        />
        {scannedIsbns.length > 0 && (
          <View style={styles.offlineListContainer}>
            <Text variant="titleSmall" style={styles.offlineListTitle}>
              Đã quét ({scannedIsbns.length} cuốn)
            </Text>
            {renderScannedList()}
          </View>
        )}
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.container} edges={['bottom']}>
      {renderCamera()}

      <View style={styles.listSection}>
        <View style={styles.listSectionHeader}>
          <Text variant="titleSmall" style={styles.listSectionTitle}>
            Đã quét ({scannedIsbns.length} cuốn)
          </Text>
          {scannedIsbns.length > 0 && (
            <Button compact onPress={() => setScannedIsbns([])} textColor={c.error}>
              Xoá tất cả
            </Button>
          )}
        </View>
        {renderScannedList()}
      </View>

      <Surface style={styles.bottomBar} elevation={2}>
        <View style={styles.bottomBarContent}>
          <View>
            <Text variant="bodySmall" style={styles.bottomBarCount}>
              {scannedIsbns.length} cuốn đã quét
            </Text>
            {validCount > 0 && (
              <Text variant="bodySmall" style={styles.bottomBarValid}>
                {validCount} cuốn hợp lệ
              </Text>
            )}
          </View>
          <Button
            mode="contained"
            onPress={handleImport}
            loading={isImporting}
            disabled={isImporting || validCount === 0}
            icon="package-variant-closed"
          >
            Nhập vào kho ({validCount})
          </Button>
        </View>
      </Surface>

      <Portal>
        <Dialog visible={showResult} onDismiss={() => setShowResult(false)}>
          <Dialog.Icon icon="checkbox-marked-circle-outline" />
          <Dialog.Title style={styles.dialogTitle}>
            Kết quả nhập kho
          </Dialog.Title>
          <Dialog.Content>
            {importResult && (
              <>
                <View style={styles.resultStats}>
                  <View style={styles.resultStat}>
                    <Text variant="headlineMedium" style={styles.resultStatValue}>{importResult.imported}</Text>
                    <Text variant="bodySmall" style={styles.resultStatLabel}>Thành công</Text>
                  </View>
                  <View style={styles.resultStat}>
                    <Text variant="headlineMedium" style={[styles.resultStatValue, importResult.skipped > 0 && { color: c.custom.warning }]}>{importResult.skipped}</Text>
                    <Text variant="bodySmall" style={styles.resultStatLabel}>Bỏ qua</Text>
                  </View>
                  <View style={styles.resultStat}>
                    <Text variant="headlineMedium" style={[styles.resultStatValue, importResult.errors > 0 && { color: c.error }]}>{importResult.errors}</Text>
                    <Text variant="bodySmall" style={styles.resultStatLabel}>Lỗi</Text>
                  </View>
                </View>
                <Divider style={styles.resultDivider} />
                <ScrollView style={styles.resultList}>
                  {importResult.results.map((row, idx) => (
                    <View key={idx} style={styles.resultRow}>
                      <Text variant="bodySmall" style={styles.resultRowIsbn}>{row.isbn}</Text>
                      <Text variant="bodySmall" style={styles.resultRowTitle} numberOfLines={1}>{row.title}</Text>
                      <Chip
                        compact
                        style={row.status === 'imported' || row.status === 'updated' ? styles.resultSuccessChip : styles.resultErrorChip}
                        textStyle={row.status === 'imported' || row.status === 'updated' ? styles.resultSuccessChipText : styles.resultErrorChipText}
                      >
                        {statusLabels[row.status] || row.status}
                      </Chip>
                    </View>
                  ))}
                </ScrollView>
              </>
            )}
          </Dialog.Content>
          <Dialog.Actions>
            <Button onPress={() => setShowResult(false)}>Đóng</Button>
          </Dialog.Actions>
        </Dialog>
      </Portal>

      <Snackbar
        visible={!!snackbarMsg}
        onDismiss={() => setSnackbarMsg(null)}
        duration={2000}
        action={{ label: 'Đóng', onPress: () => setSnackbarMsg(null) }}
      >
        {snackbarMsg}
      </Snackbar>
    </SafeAreaView>
  );
}
</file>

<file path="src/screens/MyReservationsScreen.tsx">
import React, { useState, useCallback, useMemo } from 'react';
import { View, Image, StyleSheet, ScrollView, RefreshControl, Alert } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Text, Surface, Button, useTheme, Snackbar } from 'react-native-paper';
import MaterialCommunityIcons from '@expo/vector-icons/MaterialCommunityIcons';
import { useFocusEffect } from '@react-navigation/native';
import { getMyReservations, cancelReservation, BookReservation } from '../api/borrow';
import { AppTheme } from '../theme/DarkTheme';
import { devError } from '../utils/logger';
import CacheManager from '../utils/cache/CacheManager';
import { CACHE_KEYS, CACHE_TTL } from '../utils/cache/CacheKeys';
import { useNetwork } from '../context/NetworkContext';

interface MyReservationsScreenProps {
  navigation: any;
}

export default function MyReservationsScreen({ navigation }: MyReservationsScreenProps) {
  const theme = useTheme() as AppTheme;
  const c = theme.colors;
  const styles = useMemo(() => createStyles(theme), [theme]);
  const [reservations, setReservations] = useState<BookReservation[]>([]);
  const [refreshing, setRefreshing] = useState(false);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [snackMsg, setSnackMsg] = useState('');
  const [snackVisible, setSnackVisible] = useState(false);
  const [cancellingId, setCancellingId] = useState<string | null>(null);
  const { isOnline } = useNetwork();

  const loadReservations = useCallback(async (showRefresh = false) => {
    if (showRefresh) setRefreshing(true);
    try {
      setLoadError(null);
      
      const cache = CacheManager.getInstance();
      const cached = await cache.get<{ items: BookReservation[] }>(CACHE_KEYS.RESERVATIONS);
      if (cached) {
        setReservations(cached.items);
        setRefreshing(false);
      }

      try {
        const data = await getMyReservations();
        setReservations(data.items);
        await cache.set(CACHE_KEYS.RESERVATIONS, data, CACHE_TTL.RESERVATIONS);
      } catch (error: any) {
        if (!cached) {
          devError('Failed to load reservations:', error);
          setLoadError(error?.response?.data?.detail || error?.message || 'Không thể tải danh sách đặt chỗ');
        }
      } finally {
        setRefreshing(false);
      }
    } catch (error: any) {
      devError('Failed to load reservations:', error);
      setLoadError(error?.response?.data?.detail || error?.message || 'Không thể tải danh sách đặt chỗ');
    } finally {
      setRefreshing(false);
    }
  }, []);

  useFocusEffect(
    useCallback(() => {
      loadReservations();
    }, [loadReservations])
  );

  const handleCancel = useCallback((reservation: BookReservation) => {
    if (!isOnline) {
      Alert.alert('Requires Network', 'Cancelling reservations requires an internet connection.');
      return;
    }
    
    Alert.alert(
      'Hủy đặt chỗ?',
      `Bạn có chắc muốn hủy đặt chỗ "${reservation.book?.title || 'sách này'}"?`,
      [
        { text: 'Hủy bỏ', style: 'cancel' },
        {
          text: 'OK',
          onPress: async () => {
            setCancellingId(reservation.id);
            try {
              await cancelReservation(reservation.id);
              setReservations((prev) => prev.filter((r) => r.id !== reservation.id));
              setSnackMsg('Đã hủy đặt chỗ');
              setSnackVisible(true);
            } catch (error: any) {
              const msg = error?.response?.data?.detail || error?.message || 'Không thể hủy đặt chỗ';
              setSnackMsg(msg);
              setSnackVisible(true);
            } finally {
              setCancellingId(null);
            }
          },
        },
      ]
    );
  }, []);

  const getExpiryHours = (expiresAt: string): number => {
    const now = new Date();
    const expiry = new Date(expiresAt);
    return Math.ceil((expiry.getTime() - now.getTime()) / (1000 * 60 * 60));
  };

  const getExpiryLabel = (expiresAt: string): string => {
    const hours = getExpiryHours(expiresAt);
    if (hours < 0) return 'Đã hết hạn';
    if (hours < 1) return 'Sắp hết hạn';
    if (hours < 24) return `Còn ${hours} giờ`;
    const days = Math.floor(hours / 24);
    return `Còn ${days} ngày`;
  };

  return (
    <SafeAreaView style={[styles.container, { backgroundColor: c.background }]} edges={['bottom']}>
      <ScrollView
        style={styles.flex}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={() => loadReservations(true)} tintColor={c.primary} />
        }
      >
        <View style={styles.header}>
          <View style={[styles.headerSpine, { backgroundColor: c.primary }]} />
          <Text style={[styles.headerTitle, { color: c.onSurface }]}>Danh sách đặt chỗ</Text>
          {reservations.length > 0 && (
            <Text style={[styles.countBadge, { color: c.onSurfaceVariant }]}>
              {reservations.length} đặt chỗ
            </Text>
          )}
        </View>

        {loadError ? (
          <Surface style={[styles.stateCard, { backgroundColor: c.surface, borderColor: c.outline }]} elevation={0}>
            <MaterialCommunityIcons name="cloud-off-outline" size={36} color={c.onSurfaceVariant} />
            <Text variant="bodyMedium" style={[styles.stateText, { color: c.onSurface }]}>{loadError}</Text>
            <Button
              mode="outlined"
              onPress={() => loadReservations()}
              style={styles.stateButton}
              labelStyle={styles.stateButtonLabel}
              icon="refresh"
            >
              Thử lại
            </Button>
          </Surface>
        ) : reservations.length === 0 ? (
          <Surface style={[styles.stateCard, { backgroundColor: c.surface, borderColor: c.outline }]} elevation={0}>
            <MaterialCommunityIcons name="bookshelf" size={36} color={c.onSurfaceVariant} />
            <Text variant="bodyMedium" style={[styles.stateText, { color: c.onSurface }]}>
              Bạn chưa đặt chỗ sách nào
            </Text>
          </Surface>
        ) : (
          reservations.map((reservation) => {
            const expiryHours = getExpiryHours(reservation.expires_at);
            const isUrgent = expiryHours < 2 && expiryHours >= 0;
            const isExpired = expiryHours < 0;
            return (
              <Surface
                key={reservation.id}
                style={[styles.resCard, { backgroundColor: c.surface, borderColor: c.outline }]}
                elevation={0}
              >
                <View style={[styles.resCardSpine, { backgroundColor: isExpired ? c.error : c.primary }]} />
                {reservation.book?.cover_url ? (
                  <Image source={{ uri: reservation.book.cover_url }} style={styles.bookCover} />
                ) : (
                  <View style={[styles.bookCoverPlaceholder, { backgroundColor: c.surfaceVariant }]}>
                    <MaterialCommunityIcons name="book-variant" size={24} color={c.onSurfaceVariant} />
                  </View>
                )}
                <View style={styles.resContent}>
                  <Text style={[styles.bookTitle, { color: c.onSurface }]} numberOfLines={2}>
                    {reservation.book?.title || reservation.book_id}
                  </Text>
                  {reservation.book?.author && (
                    <Text style={[styles.bookAuthor, { color: c.onSurfaceVariant }]} numberOfLines={1}>
                      {reservation.book.author}
                    </Text>
                  )}
                  <View style={styles.resMeta}>
                    <Surface style={[styles.statusBadge, { backgroundColor: c.custom.success }]} elevation={0}>
                      <Text style={[styles.statusBadgeText, { color: '#FFFFFF' }]}>Đang chờ</Text>
                    </Surface>
                    <Surface
                      style={[
                        styles.expiryBadge,
                        { backgroundColor: isExpired || isUrgent ? c.error : c.surfaceVariant },
                      ]}
                      elevation={0}
                    >
                      <Text
                        style={[
                          styles.expiryText,
                          { color: isExpired || isUrgent ? '#FFFFFF' : c.onSurfaceVariant },
                        ]}
                      >
                        {getExpiryLabel(reservation.expires_at)}
                      </Text>
                    </Surface>
                  </View>
                </View>
                <View style={styles.resActions}>
                  <Button
                    mode="outlined"
                    onPress={() => handleCancel(reservation)}
                    loading={cancellingId === reservation.id}
                    disabled={cancellingId === reservation.id}
                    style={styles.cancelButton}
                    labelStyle={styles.cancelButtonLabel}
                    textColor={c.error}
                    compact
                  >
                    Hủy
                  </Button>
                </View>
              </Surface>
            );
          })
        )}
      </ScrollView>

      <Snackbar
        visible={snackVisible}
        onDismiss={() => setSnackVisible(false)}
        duration={2500}
        style={{ backgroundColor: c.inverseSurface }}
        action={{ label: 'OK', onPress: () => setSnackVisible(false) }}
      >
        <Text style={{ color: c.inverseOnSurface }}>{snackMsg}</Text>
      </Snackbar>
    </SafeAreaView>
  );
}

function createStyles(theme: AppTheme) {
  const c = theme.colors;
  return StyleSheet.create({
    container: { flex: 1 },
    flex: { flex: 1 },
    header: {
      flexDirection: 'row',
      alignItems: 'center',
      paddingHorizontal: 16,
      paddingTop: 20,
      paddingBottom: 4,
      gap: 10,
    },
    headerSpine: { width: 3, height: 20, borderRadius: 2 },
    headerTitle: { fontSize: 20, fontWeight: '700', flex: 1 },
    countBadge: { fontSize: 12 },
    stateCard: {
      marginHorizontal: 16,
      marginTop: 24,
      padding: 32,
      borderRadius: 10,
      alignItems: 'center',
      borderWidth: 0.5,
    },
    stateText: { marginTop: 12, marginBottom: 16, textAlign: 'center' },
    stateButton: { borderRadius: 6 },
    stateButtonLabel: { fontSize: 14 },
    resCard: {
      marginHorizontal: 16,
      marginTop: 10,
      borderRadius: 10,
      flexDirection: 'row',
      overflow: 'hidden',
      borderWidth: 0.5,
      alignItems: 'center',
    },
    resCardSpine: { width: 4, alignSelf: 'stretch' },
    bookCover: {
      width: 48,
      height: 66,
      borderRadius: 4,
      margin: 10,
      marginRight: 0,
    },
    bookCoverPlaceholder: {
      width: 48,
      height: 66,
      borderRadius: 4,
      margin: 10,
      marginRight: 0,
      alignItems: 'center',
      justifyContent: 'center',
    },
    resContent: { flex: 1, padding: 10, gap: 4 },
    bookTitle: { fontWeight: '600', fontSize: 14, lineHeight: 18 },
    bookAuthor: { fontSize: 12 },
    resMeta: { flexDirection: 'row', gap: 6, marginTop: 6, flexWrap: 'wrap' },
    statusBadge: {
      paddingHorizontal: 8,
      paddingVertical: 2,
      borderRadius: 4,
    },
    statusBadgeText: { fontSize: 11, fontWeight: '700' },
    expiryBadge: {
      paddingHorizontal: 8,
      paddingVertical: 2,
      borderRadius: 4,
    },
    expiryText: { fontSize: 11, fontWeight: '600' },
    resActions: {
      paddingRight: 10,
      paddingVertical: 10,
      alignItems: 'center',
      justifyContent: 'center',
    },
    cancelButton: {
      borderRadius: 6,
      borderColor: c.error,
    },
    cancelButtonLabel: { fontSize: 12 },
  });
}
</file>

<file path="src/screens/MySwapsScreen.tsx">
import React, { useState, useEffect, useCallback } from 'react';
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  TouchableOpacity,
  Alert,
  RefreshControl,
  ActivityIndicator,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useNavigation } from '@react-navigation/native';
import { scheduleApi, ShiftSwap } from '../api/schedule';

export default function MySwapsScreen() {
  const navigation = useNavigation<any>();
  const [swaps, setSwaps] = useState<ShiftSwap[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [respondingId, setRespondingId] = useState<string | null>(null);

  const loadData = useCallback(async () => {
    try {
      const result = await scheduleApi.listMySwaps();
      setSwaps(Array.isArray(result) ? result.filter((s) => s.status === 'pending') : []);
    } catch (err) {
      console.error('Failed to load swaps:', err);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => { loadData(); }, [loadData]);

  const onRefresh = useCallback(() => {
    setRefreshing(true);
    loadData();
  }, [loadData]);

  const handleRespond = async (id: string, action: 'accepted' | 'rejected') => {
    setRespondingId(id);
    try {
      await scheduleApi.respondSwap(id, action);
      loadData();
    } catch (err: any) {
      Alert.alert('Lỗi', err?.response?.data?.error || 'Không thể xử lý');
    } finally {
      setRespondingId(null);
    }
  };

  if (loading) {
    return (
      <View style={styles.centered}>
        <ActivityIndicator size="large" color="#6366f1" />
      </View>
    );
  }

  return (
    <ScrollView
      style={styles.container}
      refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} />}
    >
      <View style={styles.header}>
        <Text style={styles.title}>Yêu cầu đổi ca</Text>
        <TouchableOpacity
          style={styles.addButton}
          onPress={() => navigation.navigate('CreateSwap')}
        >
          <Ionicons name="add" size={22} color="#fff" />
        </TouchableOpacity>
      </View>

      {swaps.length === 0 ? (
        <View style={styles.emptyContainer}>
          <Ionicons name="swap-horizontal-outline" size={48} color="#666" />
          <Text style={styles.emptyText}>Không có yêu cầu đổi ca nào</Text>
        </View>
      ) : (
        swaps.map((swap) => (
          <View key={swap.id} style={styles.swapCard}>
            <View style={styles.swapHeader}>
              <Ionicons name="swap-horizontal" size={20} color="#6366f1" />
              <View style={styles.swapInfo}>
                <Text style={styles.swapLabel}>Yêu cầu từ</Text>
                <Text style={styles.swapStaff}>{swap.requesterStaffId.slice(0, 8)}...</Text>
              </View>
              {swap.targetStaffId && (
                <View style={styles.swapInfo}>
                  <Text style={styles.swapLabel}>Đến</Text>
                  <Text style={styles.swapStaff}>{swap.targetStaffId.slice(0, 8)}...</Text>
                </View>
              )}
              <View style={styles.swapStatus}>
                <Text style={[styles.swapStatusText, { color: '#f59e0b' }]}>Chờ duyệt</Text>
              </View>
            </View>
            {swap.reason && (
              <Text style={styles.swapReason}>Lý do: {swap.reason}</Text>
            )}
            <View style={styles.swapMeta}>
              <Text style={styles.swapMetaText}>
                Ca: {swap.requesterAssignmentId.slice(0, 8)}... → {swap.targetAssignmentId?.slice(0, 8) || 'chưa chọn'}
              </Text>
            </View>
            <View style={styles.actionRow}>
              <TouchableOpacity
                style={[styles.acceptButton, respondingId === swap.id && styles.disabledButton]}
                onPress={() => handleRespond(swap.id, 'accepted')}
                disabled={respondingId === swap.id}
              >
                <Ionicons name="checkmark" size={16} color="#fff" />
                <Text style={styles.acceptButtonText}>Chấp nhận</Text>
              </TouchableOpacity>
              <TouchableOpacity
                style={[styles.rejectButton, respondingId === swap.id && styles.disabledButton]}
                onPress={() => handleRespond(swap.id, 'rejected')}
                disabled={respondingId === swap.id}
              >
                <Ionicons name="close" size={16} color="#fff" />
                <Text style={styles.rejectButtonText}>Từ chối</Text>
              </TouchableOpacity>
            </View>
          </View>
        ))
      )}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
