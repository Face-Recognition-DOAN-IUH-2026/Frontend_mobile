import React, { useEffect, useMemo, useRef, useState } from 'react';
import {
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  StyleSheet,
  View,
  Animated,
  Dimensions,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import {
  Button,
  Text,
  TextInput,
  useTheme,
} from 'react-native-paper';
import MaterialCommunityIcons from '@expo/vector-icons/MaterialCommunityIcons';
import { AppTheme } from '../theme/DarkTheme';
import { authApi } from '../api/auth';
import { StackNavigationProp } from '@react-navigation/stack';
import { AuthStackParamList } from '../navigation/types';

const { width: SCREEN_WIDTH } = Dimensions.get('window');

interface ForgotPasswordScreenProps {
  navigation: StackNavigationProp<AuthStackParamList, 'ForgotPassword'>;
}

type Step = 1 | 2 | 3 | 4;

const STEP_COUNT = 3;

function StepIndicator({ current, total, theme }: { current: number; total: number; theme: AppTheme }) {
  return (
    <View style={stepStyles.container}>
      {Array.from({ length: total }, (_, i) => {
        const step = i + 1;
        const isActive = step === current;
        const isDone = step < current;
        return (
          <React.Fragment key={i}>
            <View
              style={[
                stepStyles.dot,
                {
                  backgroundColor: isDone
                    ? theme.colors.primary
                    : isActive
                      ? theme.colors.primary
                      : theme.colors.outlineVariant,
                  width: isActive ? 32 : 10,
                },
              ]}
            />
            {i < total - 1 && (
              <View
                style={[
                  stepStyles.line,
                  {
                    backgroundColor: isDone ? theme.colors.primary : theme.colors.outlineVariant,
                  },
                ]}
              />
            )}
          </React.Fragment>
        );
      })}
    </View>
  );
}

const stepStyles = StyleSheet.create({
