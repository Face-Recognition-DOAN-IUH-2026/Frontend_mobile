  onPickImage?: () => void;
  manualLabel?: string;
  manualPlaceholder?: string;
  showManualInput?: boolean;
  showPickImage?: boolean;
  message?: string;
}

export default function CameraFallback({
  onRetry,
  onManualSubmit,
  onPickImage,
  manualLabel = 'Nhập thông tin thủ công',
  manualPlaceholder = 'Nhập tại đây...',
  showManualInput = false,
  showPickImage = false,
