export interface HazardAlertData {
  camera_id?: string;
  location?: string;
  hazard_type?: string;
  confidence?: number;
  fire_count?: number;
  smoke_count?: number;
  timestamp?: number;
  roleTarget?: 'staff' | 'patron';
}

interface EmergencyFireAlertModalProps {
  visible: boolean;
  hazard: HazardAlertData | null;
  isStaff: boolean;
  onDismiss: () => void;
}

export default function EmergencyFireAlertModal({
  visible,
  hazard,
  isStaff,
  onDismiss,
}: EmergencyFireAlertModalProps) {
  const pulseAnim = useRef(new Animated.Value(1)).current;
  const borderAnim = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    if (!visible) return;

    // Rung cảnh báo khẩn cấp
    triggerHaptic.error();
    const hapticInterval = setInterval(() => {
      triggerHaptic.error();
    }, 2500);

    // Hiệu ứng nhấp nháy viền đỏ cảnh báo
    const pulse = Animated.loop(
      Animated.sequence([
        Animated.timing(pulseAnim, {
          toValue: 1.15,
          duration: 600,
          useNativeDriver: true,
        }),
        Animated.timing(pulseAnim, {
          toValue: 1,
          duration: 600,
          useNativeDriver: true,
        }),
      ])
    );

    const borderPulse = Animated.loop(
      Animated.sequence([
        Animated.timing(borderAnim, {
          toValue: 1,
          duration: 500,
          useNativeDriver: false,
        }),
        Animated.timing(borderAnim, {
          toValue: 0.2,
          duration: 500,
          useNativeDriver: false,
        }),
      ])
    );

    pulse.start();
    borderPulse.start();

    return () => {
      clearInterval(hapticInterval);
      pulse.stop();
      borderPulse.stop();
    };
  }, [visible, pulseAnim, borderAnim]);

  if (!hazard) return null;

  const isSmoke = hazard.hazard_type === 'smoke';
