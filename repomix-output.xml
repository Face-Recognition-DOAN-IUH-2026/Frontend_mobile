    monthNavBtn: { width: 36, height: 36, alignItems: 'center', justifyContent: 'center', borderRadius: 18 },
    monthNavTitle: { fontSize: 16, fontWeight: '800' },
    calendarWrap: { marginBottom: 16, gap: 4 },
    calendarGrid: { gap: 4 },
    calRow: { flexDirection: 'row' },
    calCell: { flex: 1, alignItems: 'center', justifyContent: 'center', paddingVertical: 6, minHeight: 40 },
    calDayHeader: { fontSize: 12, fontWeight: '700' },
    calDayNum: { fontSize: 14, fontWeight: '600' },
    calDot: { width: 5, height: 5, borderRadius: 3, marginTop: 2 },
    todayBtn: { borderWidth: 1, borderRadius: 10, paddingVertical: 10, alignItems: 'center', marginTop: 12 },
    todayBtnText: { fontSize: 14, fontWeight: '700' },
    daySection: { marginBottom: 4 },
    daySectionHeader: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingVertical: 8, paddingHorizontal: 12, borderRadius: 8, marginBottom: 6 },
    daySectionTitle: { fontSize: 15, fontWeight: '900', flex: 1 },
    shiftSection: { marginBottom: 4 },
    shiftSectionHeader: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingVertical: 6, paddingHorizontal: 8, marginBottom: 4 },
    shiftSectionTitle: { fontSize: 13, fontWeight: '700', flex: 1 },
  }), [c]);

  const [actionLoadingId, setActionLoadingId] = useState<string | null>(null);
  const [faceAssignment, setFaceAssignment] = useState<StaffScheduleAssignment | null>(null);
  const [snackbar, setSnackbar] = useState('');
  const [viewMode, setViewMode] = useState<(typeof VIEW_MODES)[number]>('Ngày');
  const [showDatePicker, setShowDatePicker] = useState(false);
  const [pickerMonth, setPickerMonth] = useState(() => new Date().getMonth());
  const [pickerYear, setPickerYear] = useState(() => new Date().getFullYear());

  const todayStr = useMemo(() => toDateInput(new Date()), []);
  const [referenceDate, setReferenceDate] = useState(todayStr);

  const weekDays = useMemo(() => getWeekDaysFromRef(referenceDate), [referenceDate]);
  const weekRange = useMemo(() => ({ from: weekDays[0], to: weekDays[6] }), [weekDays]);
  const todayIndex = useMemo(() => weekDays.indexOf(todayStr), [weekDays, todayStr]);
  const [currentIndex, setCurrentIndex] = useState<number>(todayIndex >= 0 ? todayIndex : 0);

  const slideAnim = useRef(new Animated.Value(0)).current;
  const fadeAnim = useRef(new Animated.Value(1)).current;

  const currentDate = weekDays[currentIndex];

  const { isAuthenticated, user } = useAuth();
  const isStaff = user?.role === 'admin' || user?.role === 'staff';

  const {
    data: scheduleResult,
    error: scheduleError,
    isFetching: scheduleFetching,
    refetch: refetchSchedule,
  } = useQuery({
    queryKey: ['mySchedule', weekRange.from, weekRange.to],
    queryFn: () => scheduleApi.getMySchedules(weekRange.from, weekRange.to),
    enabled: isAuthenticated && isStaff,
    staleTime: 5 * 60 * 1000,
  });

  const assignments: StaffScheduleAssignment[] = scheduleResult?.items || [];
  const loading = scheduleFetching && !scheduleResult;
  const refreshing = scheduleFetching;
  const error = scheduleError ? getErrorMessage(scheduleError, 'Không thể tải lịch trực') : null;

  const groupedByDate = useMemo(() => {
    const map = new Map<string, StaffScheduleAssignment[]>();
    for (const day of weekDays) map.set(day, []);
    for (const item of assignments) {
      const list = map.get(item.workDate);
      if (list) list.push(item);
    }
    return map;
  }, [assignments, weekDays]);

  const dayCounts = useMemo(() => {
    const counts: Record<string, number> = {};
    for (const item of assignments) {
      counts[item.workDate] = (counts[item.workDate] || 0) + 1;
    }
    return counts;
  }, [assignments]);

  const shiftSections = useMemo((): ShiftSection[] => {
    const dayItems = groupedByDate.get(currentDate) ?? [];
    const groups = new Map<string, StaffScheduleAssignment[]>();
    for (const item of dayItems) {
      const key = item.shift?.name || item.shiftId;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(item);
    }
    const sections: ShiftSection[] = [];
    for (const [shiftName, items] of groups) {
      const shift = items[0].shift;
      const timeRange = shift ? `${(shift.startTime || '').slice(0, 5)}-${(shift.endTime || '').slice(0, 5)}` : '';
      const states = items.map(getAssignmentTimeState);
      const sectionState: AssignmentTimeState = states.includes('now')
        ? 'now' : states.includes('today') ? 'today' : states.includes('upcoming') ? 'upcoming' : 'past';
      items.sort((a, b) => (a.zone?.zoneName || '').localeCompare(b.zone?.zoneName || ''));
      sections.push({
        title: timeRange ? `${shiftName} · ${timeRange}` : shiftName,
        state: sectionState,
        statusLabel: sectionState === 'now' ? 'Đang trực' : sectionState === 'today' ? 'Hôm nay' : sectionState === 'upcoming' ? 'Sắp tới' : 'Đã qua',
        data: items,
      });
    }
    const order = { now: 0, today: 1, upcoming: 2, past: 3 };
    sections.sort((a, b) => order[a.state] - order[b.state]);
    return sections;
  }, [currentDate, groupedByDate]);

  // Week view: all 7 days with day headers, assignments grouped by shift within each day
  const weekAllSections = useMemo((): DaySection[] => {
    const order = { now: 0, today: 1, upcoming: 2, past: 3 };
    return weekDays.map((date) => {
      const dayItems = groupedByDate.get(date) ?? [];
      const groups = new Map<string, StaffScheduleAssignment[]>();
      for (const item of dayItems) {
        const key = item.shift?.name || item.shiftId;
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key)!.push(item);
      }
      const shiftSections: ShiftSection[] = [];
      for (const [shiftName, items] of groups) {
        const shift = items[0].shift;
        const timeRange = shift ? `${(shift.startTime || '').slice(0, 5)}-${(shift.endTime || '').slice(0, 5)}` : '';
        const states = items.map(getAssignmentTimeState);
        const sectionState: AssignmentTimeState = states.includes('now') ? 'now' : states.includes('today') ? 'today' : states.includes('upcoming') ? 'upcoming' : 'past';
        items.sort((a, b) => (a.zone?.zoneName || '').localeCompare(b.zone?.zoneName || ''));
        shiftSections.push({
          title: timeRange ? `${shiftName} · ${timeRange}` : shiftName,
          state: sectionState,
          statusLabel: sectionState === 'now' ? 'Đang trực' : sectionState === 'today' ? 'Hôm nay' : sectionState === 'upcoming' ? 'Sắp tới' : 'Đã qua',
          data: items,
        });
      }
      shiftSections.sort((a, b) => order[a.state] - order[b.state]);

      const dayState: AssignmentTimeState = shiftSections.length === 0 ? 'past'
        : shiftSections.some(s => s.state === 'now') ? 'now'
        : shiftSections.some(s => s.state === 'today') ? 'today'
        : shiftSections.some(s => s.state === 'upcoming') ? 'upcoming'
        : 'past';

      const d = new Date(date + 'T00:00:00');
      const dayNum = String(d.getDate()).padStart(2, '0');
      const monthNum = String(d.getMonth() + 1).padStart(2, '0');

      return {
        title: `${DAY_LABELS[d.getDay()]}, ${dayNum}/${monthNum}`,
        date,
        state: dayState,
        statusLabel: dayState === 'now' ? 'Đang trực' : dayState === 'today' ? 'Hôm nay' : dayState === 'upcoming' ? 'Sắp tới' : 'Đã qua',
        data: shiftSections,
      };
    });
  }, [weekDays, groupedByDate]);

  // Month view: days in month that have assignments
  const monthSections = useMemo((): DaySection[] => {
    const sections: DaySection[] = [];
    const order = { now: 0, today: 1, upcoming: 2, past: 3 };

    // First pass: collect raw items by date
    const itemsByDate = new Map<string, StaffScheduleAssignment[]>();
    for (const item of assignments) {
      const d = new Date(item.workDate + 'T00:00:00');
      if (d.getMonth() === pickerMonth && d.getFullYear() === pickerYear) {
        const dateStr = item.workDate;
        if (!itemsByDate.has(dateStr)) itemsByDate.set(dateStr, []);
        itemsByDate.get(dateStr)!.push(item);
      }
    }

    // Second pass: build DaySections with grouped shifts
    for (const [dateStr, items] of itemsByDate) {
      const d = new Date(dateStr + 'T00:00:00');
      const dayNum = String(d.getDate()).padStart(2, '0');
      const monthNum = String(d.getMonth() + 1).padStart(2, '0');

      const groups = new Map<string, StaffScheduleAssignment[]>();
      for (const item of items) {
        const key = item.shift?.name || item.shiftId;
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key)!.push(item);
      }

      const shiftSecs: ShiftSection[] = [];
      for (const [shiftName, shiftItems] of groups) {
        const shift = shiftItems[0].shift;
        const timeRange = shift ? `${(shift.startTime || '').slice(0, 5)}-${(shift.endTime || '').slice(0, 5)}` : '';
        const states = shiftItems.map(getAssignmentTimeState);
        const sectionState: AssignmentTimeState = states.includes('now') ? 'now' : states.includes('today') ? 'today' : states.includes('upcoming') ? 'upcoming' : 'past';
        shiftItems.sort((a, b) => (a.zone?.zoneName || '').localeCompare(b.zone?.zoneName || ''));
        shiftSecs.push({
          title: timeRange ? `${shiftName} · ${timeRange}` : shiftName,
          state: sectionState,
          statusLabel: sectionState === 'now' ? 'Đang trực' : sectionState === 'today' ? 'Hôm nay' : sectionState === 'upcoming' ? 'Sắp tới' : 'Đã qua',
          data: shiftItems,
        });
      }
      shiftSecs.sort((a, b) => order[a.state] - order[b.state]);

      const dayState: AssignmentTimeState = shiftSecs.length === 0 ? 'past'
        : shiftSecs.some(s => s.state === 'now') ? 'now'
        : shiftSecs.some(s => s.state === 'today') ? 'today'
        : shiftSecs.some(s => s.state === 'upcoming') ? 'upcoming'
        : 'past';

      sections.push({
        title: `${DAY_LABELS[d.getDay()]}, ${dayNum}/${monthNum}`,
        date: dateStr,
        state: dayState,
        statusLabel: dayState === 'now' ? 'Đang trực' : dayState === 'today' ? 'Hôm nay' : dayState === 'upcoming' ? 'Sắp tới' : 'Đã qua',
        data: shiftSecs,
      });
    }
    return sections;
  }, [assignments, pickerMonth, pickerYear]);

  useFocusEffect(useCallback(() => { if (isAuthenticated && isStaff) refetchSchedule(); }, [isAuthenticated, isStaff, refetchSchedule]));

  const onRefresh = async () => {
    await refetchSchedule();
  };

  const runAttendanceAction = async (id: string, action: 'check-in' | 'check-out') => {
    setActionLoadingId(`${id}:${action}`);
    try {
      if (action === 'check-in') {
        let lat: number | undefined;
        let lng: number | undefined;
        try {
          const { status } = await Location.requestForegroundPermissionsAsync();
          if (status === 'granted') {
            const pos = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.High });
            lat = pos.coords.latitude;
            lng = pos.coords.longitude;
          }
        } catch (locErr) {
          devError('[ScheduleScreen] Location error:', locErr);
        }
        await scheduleApi.checkIn(id, lat, lng);
        setSnackbar('Đã check-in thành công');
      } else {
        await scheduleApi.checkOut(id);
        setSnackbar('Đã check-out thành công');
      }
      await refetchSchedule();
    } catch (err: any) {
      setSnackbar(getErrorMessage(err, action === 'check-in' ? 'Check-in thất bại' : 'Check-out thất bại'));
    } finally { setActionLoadingId(null); }
  };

  const handleRequestManualCheckIn = async (assignmentId: string) => {
    setActionLoadingId(`${assignmentId}:manual-checkin`);
    try {
      await scheduleApi.requestManualCheckIn(assignmentId, 'Yêu cầu check-in thủ công từ ứng dụng di động');
      setSnackbar('Đã gửi yêu cầu check-in thủ công');
      await refetchSchedule();
    } catch (err: any) {
      setSnackbar(getErrorMessage(err, 'Gửi yêu cầu check-in thủ công thất bại'));
    } finally { setActionLoadingId(null); }
  };

  const currentIndexRef = useRef(currentIndex);
  currentIndexRef.current = currentIndex;

  const goToDay = useCallback((index: number) => {
    if (index < 0 || index > 6) return;
    if (index === currentIndexRef.current) return;
    const direction = index > currentIndexRef.current ? 1 : -1;
    Animated.parallel([
      Animated.timing(fadeAnim, { toValue: 0, duration: 80, useNativeDriver: true }),
      Animated.timing(slideAnim, { toValue: direction, duration: 80, useNativeDriver: true }),
    ]).start(() => {
      setCurrentIndex(index);
      slideAnim.setValue(0);
      Animated.timing(fadeAnim, { toValue: 1, duration: 100, useNativeDriver: true }).start();
    });
  }, [fadeAnim, slideAnim]);

  const navRef = useRef({ goPrev: () => {}, goNext: () => {} });
  navRef.current = {
    goPrev: () => goToDay(currentIndexRef.current - 1),
    goNext: () => goToDay(currentIndexRef.current + 1),
  };

  const panResponder = useRef(
    PanResponder.create({
      onMoveShouldSetPanResponder: (_, gs) => Math.abs(gs.dx) > 15 && Math.abs(gs.dx) > Math.abs(gs.dy),
      onPanResponderRelease: (_, gs) => {
        if (gs.dx > 60) navRef.current.goPrev();
        else if (gs.dx < -60) navRef.current.goNext();
      },
    }),
  ).current;

  const currentDateFormatted = useMemo(() => {
    const d = new Date(currentDate + 'T00:00:00');
    const dayLabel = DAY_LABELS[d.getDay()];
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    return `Th ${dayLabel}, ${day}/${month}/${year}`;
  }, [currentDate]);

  const handleViewModeChange = (mode: (typeof VIEW_MODES)[number]) => {
    setViewMode(mode);
    if (mode === 'Tháng') {
      const d = new Date(currentDate + 'T00:00:00');
      setPickerMonth(d.getMonth());
      setPickerYear(d.getFullYear());
    }
  };

  const handleDatePicked = (dateStr: string) => {
    const idx = weekDays.indexOf(dateStr);
    if (idx >= 0) {
      setCurrentIndex(idx);
      setViewMode('Ngày');
      setShowDatePicker(false);
    } else {
      const newWeekDays = getWeekDaysFromRef(dateStr);
      const newIdx = newWeekDays.indexOf(dateStr);
      setCurrentIndex(newIdx >= 0 ? newIdx : 0);
      setReferenceDate(dateStr);
      setViewMode('Ngày');
      setShowDatePicker(false);
    }
  };

  // Month calendar data
  const monthGrid = useMemo(() => getMonthGrid(pickerYear, pickerMonth), [pickerYear, pickerMonth]);

  const monthAssignmentMap = useMemo(() => {
    const map: Record<number, boolean> = {};
    for (const item of assignments) {
      const d = new Date(item.workDate + 'T00:00:00');
      if (d.getMonth() === pickerMonth && d.getFullYear() === pickerYear) {
        map[d.getDate()] = true;
      }
    }
    return map;
  }, [assignments, pickerMonth, pickerYear]);

  // Helpers
  function renderEmptyState(message?: string) {
    return (
      <EmptyState
        icon="folder-open-outline"
        title="Không có dữ liệu"
        description={message || 'Ngày này không có lịch trực'}
      />
    );
  }

  function renderMainList() {
    const listSections = shiftSections;

    const flatItems = listSections
      .flatMap(sec => sec.data.map(item => ({ ...item, _shiftName: sec.title.split(' · ')[0], _shiftTime: sec.title.split(' · ')[1] || '' })))
      .sort((a, b) => {
        const aStart = a.shift?.startTime || '';
        const bStart = b.shift?.startTime || '';
        return aStart.localeCompare(bStart);
      });

    if (flatItems.length === 0) {
      return (
        <ScrollView contentContainerStyle={s.emptyContentStyle} refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}>
          {renderEmptyState()}
        </ScrollView>
      );
    }

    const d = new Date(currentDate + 'T00:00:00');
    const dayLabel = `${VI_DAYS[d.getDay()]} ${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`;

    return (
      <FlatList
        data={flatItems}
        keyExtractor={(item) => item.id}
        ListHeaderComponent={
          <View style={[s.daySectionHeader, { backgroundColor: c.surfaceVariant, marginBottom: 12 }]}>
            <Text style={[s.daySectionTitle, { color: c.primary }]}>{dayLabel}</Text>
          </View>
        }
        renderItem={({ item }) => (
          <AssignmentCard
            item={item}
            onCheckIn={(id) => runAttendanceAction(id, 'check-in')}
            onFaceCheckIn={(it) => setFaceAssignment(it)}
            onCheckOut={(id) => runAttendanceAction(id, 'check-out')}
            onRequestManualCheckIn={handleRequestManualCheckIn}
            actionLoadingId={actionLoadingId}
            shiftLabel={item._shiftName}
            shiftTime={item._shiftTime}
          />
        )}
        ItemSeparatorComponent={() => <View style={{ height: 8 }} />}
        contentContainerStyle={s.listContent}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}
      />
    );
  }

  // Render day section with nested shift grouping (for week/month views)
  function renderDaySection(section: DaySection, sectionIdx: number) {
    if (section.data.length === 0) return null;

    const d = new Date(section.date + 'T00:00:00');
    const dayOfWeek = d.getDay();
    const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;

    const order = { now: 0, today: 1, upcoming: 2, past: 3 };

    const flatItems = section.data
      .flatMap(dayShift => dayShift.data.map(item => ({ ...item, _shiftName: dayShift.title.split(' · ')[0], _shiftTime: dayShift.title.split(' · ')[1] || '' })))
      .sort((a, b) => {
        const aStart = a.shift?.startTime || '';
        const bStart = b.shift?.startTime || '';
        return aStart.localeCompare(bStart);
      });

    return (
      <View key={section.date} style={s.daySection}>
        <View style={[s.daySectionHeader, { backgroundColor: c.surfaceVariant }]}>
          <Text style={[s.daySectionTitle, { color: c.primary }]}>{section.title}</Text>
        </View>
        {flatItems.map((item) => (
          <AssignmentCard
            key={item.id}
            item={item}
            onCheckIn={(id) => runAttendanceAction(id, 'check-in')}
            onFaceCheckIn={(it) => setFaceAssignment(it)}
            onCheckOut={(id) => runAttendanceAction(id, 'check-out')}
            onRequestManualCheckIn={handleRequestManualCheckIn}
            actionLoadingId={actionLoadingId}
            shiftLabel={item._shiftName}
            shiftTime={item._shiftTime}
          />
        ))}
      </View>
    );
  }

  function renderWeekList() {
    const daysWithData = weekAllSections.filter(d => d.data.length > 0);
    if (daysWithData.length === 0) {
      return (
        <ScrollView contentContainerStyle={s.scrollFlex} refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}>
          {renderEmptyState()}
        </ScrollView>
      );
    }
    return (
      <FlatList
        data={weekAllSections}
        keyExtractor={(item) => item.date}
        renderItem={({ item, index }) => renderDaySection(item, index)}
        ListHeaderComponent={
          <View style={[s.pillStrip, { backgroundColor: c.surface, borderBottomColor: c.divider }]}>
            <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={s.pillContent}>
              {weekDays.map((date, idx) => {
                const isSelected = idx === currentIndex;
                const isTodayDate = date === todayStr;
                const count = dayCounts[date] || 0;
                return (
                  <TouchableOpacity
                    key={date}
                    onPress={() => { setCurrentIndex(idx); }}
                    activeOpacity={0.7}
                    style={[s.pill, { backgroundColor: isSelected ? c.primary : c.surfaceVariant, borderColor: isTodayDate && !isSelected ? c.primary : 'transparent' }]}
                  >
                    <Text style={[s.pillLabel, { color: isSelected ? c.onPrimary : c.primary }]}>{DAY_LABELS[idx]}</Text>
                    <Text style={[s.pillDate, { color: isSelected ? c.onPrimary : c.primary }, isTodayDate && !isSelected && { fontWeight: '900' }]}>{date.slice(8, 10)}</Text>
                    {count > 0 ? (
                      <View style={[s.pillBadge, { backgroundColor: isSelected ? c.onPrimary : c.primary }]}>
                        <Text style={[s.pillBadgeText, { color: isSelected ? c.primary : c.onPrimary }]}>{count}</Text>
                      </View>
                    ) : null}
                  </TouchableOpacity>
                );
              })}
            </ScrollView>
          </View>
        }
        ItemSeparatorComponent={() => <View style={{ height: 12 }} />}
        contentContainerStyle={s.listContent}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}
      />
    );
  }

  function renderMonthList() {
    const monthHasAssignments = new Set(monthSections.map(s => s.date));

    function renderCalendarGrid() {
      return (
        <View style={[s.calendarWrap, { backgroundColor: c.surface }]}>
          <View style={s.calRow}>
            {['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'].map((d) => (
              <View key={d} style={s.calCell}><Text style={[s.calDayHeader, { color: c.primary }]}>{d}</Text></View>
            ))}
          </View>
          {Array.from({ length: Math.ceil(monthGrid.length / 7) }, (_, rowIdx) => (
            <View key={rowIdx} style={s.calRow}>
              {monthGrid.slice(rowIdx * 7, (rowIdx + 1) * 7).map((day, colIdx) => {
                if (day === null) return <View key={`e-${colIdx}`} style={s.calCell} />;
                const isCurrentMonth = day > 0;
                const dateStr = isCurrentMonth
                  ? `${pickerYear}-${String(pickerMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`
                  : '';
                const isToday = dateStr === todayStr;
                const hasAssignments = monthHasAssignments.has(dateStr);
                return (
                  <TouchableOpacity
                    key={`d-${day}`}
                    style={[s.calCell, isToday && { borderWidth: 1.5, borderColor: c.primary, borderRadius: 8 }]}
                    onPress={() => { if (dateStr && hasAssignments) handleDatePicked(dateStr); }}
                    disabled={!isCurrentMonth || !hasAssignments}
                  >
                    <Text style={[s.calDayNum, {
                      color: isCurrentMonth ? (hasAssignments ? c.primary : c.onSurface) : c.outline,
                      fontWeight: isToday ? '900' : hasAssignments ? '700' : '400',
                    }]}>
                      {isCurrentMonth ? day : Math.abs(day)}
                    </Text>
                  </TouchableOpacity>
                );
              })}
            </View>
          ))}
        </View>
      );
    }

    if (monthSections.length === 0) {
      return (
        <ScrollView contentContainerStyle={s.scrollFlex} refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}>
          {renderCalendarGrid()}
          {renderEmptyState('Tháng này không có ca trực')}
        </ScrollView>
      );
    }
    return (
      <FlatList
        data={monthSections}
        keyExtractor={(item) => item.date}
        renderItem={({ item, index }) => renderDaySection(item, index)}
        ListHeaderComponent={
          <View>
            <View style={[s.monthNav, { backgroundColor: c.surface, borderBottomColor: c.divider }]}>
              <TouchableOpacity onPress={() => { if (pickerMonth === 0) { setPickerMonth(11); setPickerYear(py => py - 1); } else setPickerMonth(pm => pm - 1); }} style={s.monthNavBtn}>
                <MaterialCommunityIcons name="chevron-left" size={22} color={c.onSurface} />
              </TouchableOpacity>
              <TouchableOpacity onPress={() => { setShowDatePicker(true); }}>
                <Text style={[s.monthNavTitle, { color: c.onSurface }]}>{VI_MONTHS[pickerMonth]} {pickerYear}</Text>
              </TouchableOpacity>
              <TouchableOpacity onPress={() => { if (pickerMonth === 11) { setPickerMonth(0); setPickerYear(py => py + 1); } else setPickerMonth(pm => pm + 1); }} style={s.monthNavBtn}>
                <MaterialCommunityIcons name="chevron-right" size={22} color={c.onSurface} />
              </TouchableOpacity>
            </View>
            {renderCalendarGrid()}
          </View>
        }
        ItemSeparatorComponent={() => <View style={{ height: 12 }} />}
        contentContainerStyle={s.listContent}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={c.primary} />}
      />
    );
  }

  function renderWeekStrip(activeIdx: number, onSelect: (idx: number) => void) {
    return (
      <View style={[s.pillStrip, { backgroundColor: c.surface, borderBottomColor: c.divider }]}>
        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={s.pillContent}>
          {weekDays.map((date, idx) => {
            const isSelected = idx === activeIdx;
            const isTodayDate = date === todayStr;
            const count = dayCounts[date] || 0;
            return (
              <TouchableOpacity
                key={date}
                onPress={() => onSelect(idx)}
                activeOpacity={0.7}
                style={[
                  s.pill,
                  {
                    backgroundColor: isSelected ? c.primary : c.surfaceVariant,
                    borderColor: isTodayDate && !isSelected ? c.primary : 'transparent',
                  },
                ]}
              >
                <Text style={[s.pillLabel, { color: isSelected ? c.onPrimary : c.onSurfaceVariant }]}>
                  {DAY_LABELS[idx]}
                </Text>
                <Text style={[s.pillDate, { color: isSelected ? c.onPrimary : c.onSurface }, isTodayDate && !isSelected && { color: c.primary, fontWeight: '900' }]}>
                  {date.slice(8, 10)}
                </Text>
                {count > 0 ? (
                  <View style={[s.pillBadge, { backgroundColor: isSelected ? c.onPrimary : c.primary }]}>
                    <Text style={[s.pillBadgeText, { color: isSelected ? c.primary : c.onPrimary }]}>{count}</Text>
                  </View>
                ) : null}
              </TouchableOpacity>
            );
          })}
        </ScrollView>
      </View>
    );
  }

  return (
    <SafeAreaView style={[s.container, { backgroundColor: c.background }]} edges={['bottom']}>
      <GradientHeader
        title="Lịch trực"
        subtitle={assignments.length > 0 ? `${assignments.length} ca trực` : 'Không có ca trực'}
        icon="calendar-clock"
      />

      {/* Segmented Control */}
      <View style={[s.segmentedWrap, { backgroundColor: c.surface }]}>
        <View style={[s.segmentedBg, { backgroundColor: c.surfaceVariant }]}>
          {VIEW_MODES.map((mode) => {
            const active = viewMode === mode;
            return (
              <TouchableOpacity key={mode} onPress={() => handleViewModeChange(mode)} style={[s.segmentedBtn, active && { backgroundColor: c.primary }]}>
                <Text style={[s.segmentedText, { color: active ? c.onPrimary : c.onSurfaceVariant }, active && { fontWeight: '700' }]}>{mode}</Text>
              </TouchableOpacity>
            );
          })}
        </View>
      </View>

      {/* Date Dropdown */}
      {viewMode !== 'Tháng' ? (
        <View style={[s.dateRow, { backgroundColor: c.surface, borderBottomColor: c.divider }]}>
          <TouchableOpacity style={s.dateDropdown} onPress={() => { setShowDatePicker(true); const d = new Date(currentDate + 'T00:00:00'); setPickerMonth(d.getMonth()); setPickerYear(d.getFullYear()); }}>
            <Text style={[s.dateText, { color: c.onSurface }]}>{currentDateFormatted}</Text>
            <MaterialCommunityIcons name="chevron-down" size={20} color={c.onSurfaceVariant} />
          </TouchableOpacity>
        </View>
      ) : null}

{/* Content */}
      {loading ? (
        <LoadingOverlay loading message="Đang tải lịch trực..." />
      ) : error ? (
        <View style={s.errorBox}><MaterialCommunityIcons name="alert-circle-outline" size={22} color={c.error} /><Text style={[s.errorText, { color: c.error }]} selectable>{error}</Text></View>
      ) : viewMode === 'Ngày' ? (
        <Animated.View style={[s.contentFlex, { opacity: fadeAnim, transform: [{ translateX: slideAnim.interpolate({ inputRange: [-1, 0, 1], outputRange: [SCREEN_WIDTH * 0.3, 0, -SCREEN_WIDTH * 0.3] }) }] }]} {...panResponder.panHandlers}>
          {renderMainList()}
        </Animated.View>
      ) : viewMode === 'Tuần' ? (
        renderWeekList()
      ) : (
        /* Tháng view */
        renderMonthList()
      )}

      {/* Date Picker Modal */}
      <Modal visible={showDatePicker} transparent animationType="fade" onRequestClose={() => setShowDatePicker(false)}>
        <TouchableOpacity style={s.modalOverlay} activeOpacity={1} onPress={() => setShowDatePicker(false)}>
          <View style={[s.modalContent, { backgroundColor: c.surface }]}>
            <View style={[s.monthNav, { borderBottomColor: c.divider }]}>
              <TouchableOpacity onPress={() => { if (pickerMonth === 0) { setPickerMonth(11); setPickerYear(py => py - 1); } else setPickerMonth(pm => pm - 1); }} style={s.monthNavBtn}>
                <MaterialCommunityIcons name="chevron-left" size={22} color={c.onSurface} />
              </TouchableOpacity>
              <Text style={[s.monthNavTitle, { color: c.onSurface }]}>{VI_MONTHS[pickerMonth]} {pickerYear}</Text>
              <TouchableOpacity onPress={() => { if (pickerMonth === 11) { setPickerMonth(0); setPickerYear(py => py + 1); } else setPickerMonth(pm => pm + 1); }} style={s.monthNavBtn}>
                <MaterialCommunityIcons name="chevron-right" size={22} color={c.onSurface} />
              </TouchableOpacity>
            </View>
            <View style={s.calendarGrid}>
              <View style={s.calRow}>
                {['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'].map((d) => (
                  <View key={d} style={s.calCell}><Text style={[s.calDayHeader, { color: c.onSurfaceVariant }]}>{d}</Text></View>
                ))}
              </View>
              {Array.from({ length: Math.ceil(monthGrid.length / 7) }, (_, rowIdx) => (
                <View key={rowIdx} style={s.calRow}>
                  {monthGrid.slice(rowIdx * 7, (rowIdx + 1) * 7).map((day, colIdx) => {
                    if (day === null) return <View key={`e-${colIdx}`} style={s.calCell} />;
                    const isCurrentMonth = day > 0;
                    const dateStr = isCurrentMonth
                      ? `${pickerYear}-${String(pickerMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`
                      : '';
                    const isToday = dateStr === todayStr;
                    return (
                      <TouchableOpacity
                        key={`d-${day}`}
                        style={[s.calCell, isToday && { borderWidth: 1, borderColor: c.primary, borderRadius: 8 }]}
                        onPress={() => { if (dateStr) handleDatePicked(dateStr); }}
                        disabled={!isCurrentMonth}
                      >
                        <Text style={[s.calDayNum, { color: isCurrentMonth ? c.onSurface : c.outline }, isToday && { color: c.primary, fontWeight: '900' }]}>
                          {isCurrentMonth ? day : Math.abs(day)}
                        </Text>
                      </TouchableOpacity>
                    );
                  })}
                </View>
              ))}
            </View>
            <TouchableOpacity style={[s.todayBtn, { borderColor: c.primary }]} onPress={() => handleDatePicked(todayStr)}>
              <Text style={[s.todayBtnText, { color: c.primary }]}>Hôm nay</Text>
            </TouchableOpacity>
          </View>
        </TouchableOpacity>
      </Modal>

      <FaceCheckInModal
        visible={!!faceAssignment}
        assignment={faceAssignment}
        onClose={() => setFaceAssignment(null)}
        onSuccess={(msg) => {
          setSnackbar(msg);
          refetchSchedule();
        }}
      />

      <NoticeSnackbar
        visible={!!snackbar}
        message={snackbar}
        severity="success"
        onDismiss={() => setSnackbar('')}
      />
    </SafeAreaView>
  );
}
</file>

<file path="src/features/auth/screens/RegisterScreen.tsx">
import React, { useMemo, useState, useRef, useEffect, useCallback } from 'react';
import { ActivityIndicator, ScrollView, StyleSheet, View } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Button, Text, TextInput, useTheme } from 'react-native-paper';
import api from '../../../api/client';
import { waitForEnrollment } from '../../../api/enrollment';
import { authApi } from '../../../api/auth';
import AutoFaceCapture from '../../../components/AutoFaceCapture';
import StudentCardScanner, { ScannedCardData } from '../../../components/StudentCardScanner';
import CodeInput from '../../../components/CodeInput';
import { AppTheme } from '../../../theme/DarkTheme';
import { SectionCard, GRADIENTS } from '../../../theme/MobileDesignSystem';
import { LoadingOverlay } from '../../../components/LoadingOverlay';
import { NoticeSnackbar } from '../../../components/NoticeSnackbar';
import MaterialCommunityIcons from '@expo/vector-icons/MaterialCommunityIcons';

interface RegisterScreenProps {
  navigation: any;
}

type StepKey = 'scan' | 'form' | 'otp' | 'choice' | 'consent' | 'face';

const STEP_META: Record<StepKey, { label: string; icon: string }> = {
  scan: { label: 'Quét thẻ', icon: 'card-account-details-outline' },
  form: { label: 'Thông tin', icon: 'form-textbox' },
  otp: { label: 'Xác thực', icon: 'email-check-outline' },
  choice: { label: 'Hoàn tất', icon: 'check-circle-outline' },
  consent: { label: 'Đồng ý', icon: 'file-document-check' },
  face: { label: 'Khuôn mặt', icon: 'face-recognition' },
};

const FORM_STEPS: StepKey[] = ['form', 'otp', 'choice', 'consent', 'face'];

function StepIndicator({ currentStep }: { currentStep: StepKey }) {
  const currentIdx = FORM_STEPS.indexOf(currentStep);
  if (currentIdx < 0) return null;

  const theme = useTheme() as AppTheme;

  return (
    <View style={stepStyles.container}>
      {FORM_STEPS.map((key, idx) => {
        const isActive = idx === currentIdx;
        const isDone = idx < currentIdx;
        return (
          <React.Fragment key={key}>
            <View style={stepStyles.stepItem}>
              <View
                style={[
                  stepStyles.dot,
                  {
                    backgroundColor: isDone
                      ? theme.colors.primary
                      : isActive
                        ? theme.colors.primary
                        : theme.colors.outlineVariant,
                  },
                ]}
              >
                {isDone ? (
                  <MaterialCommunityIcons name="check" size={12} color={theme.colors.onPrimary} />
                ) : (
                  <Text style={[stepStyles.dotText, { color: isActive ? theme.colors.onPrimary : theme.colors.onSurfaceVariant }]}>
                    {idx + 1}
                  </Text>
                )}
              </View>
              <Text
                style={[
                  stepStyles.label,
                  {
                    color: isActive || isDone ? theme.colors.primary : theme.colors.onSurfaceVariant,
                    fontWeight: isActive ? '700' : '500',
                  },
                ]}
              >
                {STEP_META[key].label}
              </Text>
            </View>
            {idx < FORM_STEPS.length - 1 ? (
              <View
                style={[
                  stepStyles.connector,
                  {
                    backgroundColor: isDone ? theme.colors.primary : theme.colors.outlineVariant,
                  },
                ]}
              />
            ) : null}
          </React.Fragment>
        );
      })}
    </View>
  );
}

const stepStyles = StyleSheet.create({
  container: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    paddingVertical: 14,
    paddingHorizontal: 20,
    gap: 0,
  },
  stepItem: {
    alignItems: 'center',
    gap: 4,
  },
  dot: {
    width: 26,
    height: 26,
    borderRadius: 13,
    alignItems: 'center',
    justifyContent: 'center',
  },
  dotText: {
    fontSize: 11,
    fontWeight: '700',
  },
  connector: {
    flex: 1,
    height: 2,
    borderRadius: 1,
    marginHorizontal: 6,
    marginBottom: 18,
  },
  label: {
    fontSize: 10,
    letterSpacing: 0.3,
  },
});

export default function RegisterScreen({ navigation }: RegisterScreenProps) {
  const theme = useTheme() as AppTheme;
  const styles = useMemo(() => createStyles(theme), [theme]);
  const [step, setStep] = useState<StepKey>('scan');
  const [studentCode, setStudentCode] = useState('');
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [fullName, setFullName] = useState('');
  const [email, setEmail] = useState('');
  const [className, setClassName] = useState('');
  const [course, setCourse] = useState('');
  const [permanentAddress, setPermanentAddress] = useState('');
  const [registeredUser, setRegisteredUser] = useState<any>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [snackbar, setSnackbar] = useState('');
  const [snackbarSeverity, setSnackbarSeverity] = useState<'success' | 'error' | 'warning' | 'info'>('error');
  const [consentGiven, setConsentGiven] = useState(false);
  const [otpCode, setOtpCode] = useState('');
  const [verificationToken, setVerificationToken] = useState('');
  const [otpSending, setOtpSending] = useState(false);
  const [otpCooldown, setOtpCooldown] = useState(0);
  const [studentCodeCheck, setStudentCodeCheck] = useState<'idle' | 'checking' | 'exists' | 'available'>('idle');
  const [emailCheck, setEmailCheck] = useState<'idle' | 'checking' | 'exists' | 'available'>('idle');
  const otpTimerRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const checkExistsDebounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  useEffect(() => {
    return () => {
      if (otpTimerRef.current) clearInterval(otpTimerRef.current);
      if (checkExistsDebounceRef.current) clearTimeout(checkExistsDebounceRef.current);
    };
  }, []);

  useEffect(() => {
    if (step !== 'otp') {
      if (otpTimerRef.current) {
        clearInterval(otpTimerRef.current);
        otpTimerRef.current = null;
      }
    }
  }, [step]);

  useEffect(() => {
    let ignore = false;
    if (checkExistsDebounceRef.current) clearTimeout(checkExistsDebounceRef.current);

    const code = studentCode.trim();
    const mail = email.trim();
    const codeValid = code.length >= 4;
    const mailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail);

    if (!codeValid && !mailValid) {
      setStudentCodeCheck('idle');
      setEmailCheck('idle');
      return;
    }

    if (codeValid) setStudentCodeCheck('checking');
    if (mailValid) setEmailCheck('checking');

    checkExistsDebounceRef.current = setTimeout(() => {
      authApi.checkExists(codeValid ? code : '', mailValid ? mail : '').then(result => {
        if (ignore) return;
        setStudentCodeCheck(codeValid ? (result.student_code_exists ? 'exists' : 'available') : 'idle');
        setEmailCheck(mailValid ? (result.email_exists ? 'exists' : 'available') : 'idle');
      }).catch((e) => {
        console.warn('[Register] checkExists debounce failed', e?.message);
        if (!ignore) {
          setStudentCodeCheck('idle');
          setEmailCheck('idle');
        }
      });
    }, 500);

    return () => { ignore = true; };
  }, [studentCode, email]);

  const startOtpCooldown = () => {
    setOtpCooldown(60);
    if (otpTimerRef.current) clearInterval(otpTimerRef.current);
    otpTimerRef.current = setInterval(() => {
      setOtpCooldown((prev) => {
        if (prev <= 1) {
          if (otpTimerRef.current) clearInterval(otpTimerRef.current);
          return 0;
        }
        return prev - 1;
      });
    }, 1000);
  };

  const showError = (message: string) => { setSnackbarSeverity('error'); setSnackbar(message); };
  const showSuccess = (message: string) => { setSnackbarSeverity('success'); setSnackbar(message); };

  const handleSendOtp = async () => {
    setOtpSending(true);
    try {
      await authApi.preRegisterOtp(email.trim());
      startOtpCooldown();
      setStep('otp');
    } catch (error: any) {
      const message = error?.response?.data?.detail || error?.response?.data?.error || error?.message || 'Gui ma OTP that bai';
      showError(message);
    } finally {
      setOtpSending(false);
    }
  };

  const handleVerifyOtp = async () => {
    if (otpCode.length < 6) {
      showError('Vui long nhap day du ma OTP');
      return;
    }
    setOtpSending(true);
    try {
      const result = await authApi.preRegisterVerify(email.trim(), otpCode);
      setVerificationToken(result.verification_token);
      await authApi.patronRegister({
        student_code: studentCode.trim(),
        password,
        full_name: fullName.trim(),
        email: email.trim(),
        class_name: className.trim() || undefined,
        course: course.trim() || undefined,
        permanent_address: permanentAddress.trim() || undefined,
        verification_token: result.verification_token,
      }).then(response => {
        setRegisteredUser(response.user);
        setStep('choice');
      }).catch(error => {
        const message = error?.response?.data?.detail || error?.response?.data?.error || error?.message || 'Dang ky that bai';
        showError(message);
      });
    } catch (error: any) {
      const message = error?.response?.data?.detail || error?.response?.data?.error || error?.message || 'Ma OTP khong hop le';
      showError(message);
    } finally {
      setOtpSending(false);
    }
  };

  const handleResendOtp = async () => {
    if (otpCooldown > 0) return;
    try {
      await authApi.preRegisterOtp(email.trim());
      startOtpCooldown();
      setOtpCode('');
      showSuccess('Da gui lai ma OTP');
    } catch (error: any) {
      const message = error?.response?.data?.detail || error?.response?.data?.error || error?.message || 'Gui lai OTP that bai';
      showError(message);
    }
  };

  const handleScanned = (data: ScannedCardData) => {
    setStudentCode(data.studentCode || '');
    setFullName(data.fullName || '');
    setClassName(data.className || '');
    setCourse(data.course || '');
    setPermanentAddress(data.permanentAddress || '');
    setStep('form');
  };

  const validateForm = () => {
    if (!studentCode.trim()) {
      showError('Vui lòng nhập mã sinh viên');
      return false;
    }
    if (studentCode.length < 4) {
      showError('Mã sinh viên phải có ít nhất 4 ký tự');
      return false;
    }
    if (!fullName.trim()) {
      showError('Vui lòng nhập họ tên');
      return false;
    }
    if (!email.trim()) {
      showError('Vui lòng nhập email');
      return false;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
      showError('Email không hợp lệ');
      return false;
    }
    if (!password) {
      showError('Vui lòng nhập mật khẩu');
      return false;
    }
    if (password.length < 6) {
      showError('Mật khẩu phải có ít nhất 6 ký tự');
      return false;
    }
    if (password !== confirmPassword) {
      showError('Mật khẩu xác nhận không khớp');
      return false;
    }
    return true;
  };

  const handleFaceEnroll = async (images: string[]) => {
    if (!registeredUser?.id || images.length !== 4) return;

    setIsUploading(true);
    try {
      const formData = new FormData();
      formData.append('frontal', {
        uri: `data:image/jpeg;base64,${images[0]}`,
        type: 'image/jpeg',
        name: 'face_frontal.jpg',
      } as any);
      formData.append('right', {
        uri: `data:image/jpeg;base64,${images[1]}`,
        type: 'image/jpeg',
        name: 'face_right.jpg',
      } as any);
      formData.append('left', {
        uri: `data:image/jpeg;base64,${images[2]}`,
        type: 'image/jpeg',
        name: 'face_left.jpg',
      } as any);
      formData.append('down', {
        uri: `data:image/jpeg;base64,${images[3]}`,
        type: 'image/jpeg',
        name: 'face_down.jpg',
      } as any);
      formData.append('consent_given', consentGiven ? 'true' : 'false');

      const { data } = await api.post(`/patrons/${registeredUser.id}/enroll-batch`, formData, {
        headers: { 'Content-Type': 'multipart/form-data' },
        timeout: 130000,
      });

      await waitForEnrollment(data.job_id);
      showSuccess('Đăng ký tài khoản và khuôn mặt thành công');
      navigation.replace('Login');
    } catch (error: any) {
      const message = error?.response?.data?.detail || error?.response?.data?.error || error?.message || 'Đăng ký khuôn mặt thất bại';
      showError(message);
    } finally {
      setIsUploading(false);
    }
  };

  if (step === 'scan') {
    return (
      <View style={{ flex: 1, backgroundColor: '#0F172A' }}>
        <StudentCardScanner
          onScanned={handleScanned}
          onError={showError}
          onSkip={() => {
            setStep('form');
          }}
          onBack={() => {
            navigation.navigate('Login');
          }}
        />
        <NoticeSnackbar visible={!!snackbar} message={snackbar} severity={snackbarSeverity} onDismiss={() => setSnackbar('')} />
      </View>
    );
  }

  if (step === 'otp') {
    return (
      <SafeAreaView style={styles.container}>
        <View style={styles.headerBar}>
          <Button
            mode="text"
            onPress={() => setStep('form')}
            icon="arrow-left"
            compact
            labelStyle={styles.backLabel}
          >
            Quay lại
          </Button>
          <Text variant="titleMedium" style={styles.headerTitle}>Xác thực email</Text>
          <View style={{ width: 60 }} />
        </View>

        <StepIndicator currentStep={step} />

        <View style={styles.centeredContent}>
          <SectionCard
            title="Mã xác thực"
            icon="email-check-outline"
            accentColor={GRADIENTS.navy[0]}
            style={styles.choiceCard}
          >
            <View style={styles.otpInner}>
              <View style={styles.otpIconWrap}>
                <MaterialCommunityIcons name="email-check" size={48} color={GRADIENTS.navy[0]} />
              </View>
              <Text style={styles.otpTitle}>Nhập mã OTP</Text>
              <Text style={styles.otpSubtitle}>
                Mã xác thực gồm 6 chữ số đã được gửi đến email{'\n'}
                <Text style={styles.otpEmail}>{email}</Text>
              </Text>

              <CodeInput value={otpCode} onChange={setOtpCode} length={6} theme={theme} />

              <Button
                mode="contained"
                onPress={handleVerifyOtp}
                loading={otpSending}
                disabled={otpSending || otpCode.length < 6}
                contentStyle={styles.primaryBtn}
                labelStyle={styles.primaryBtnLabel}
                style={styles.primaryBtnWrapper}
              >
                Xác thực
              </Button>

              <Button
                mode="text"
                onPress={handleResendOtp}
                disabled={otpCooldown > 0}
                labelStyle={[styles.resendLabel, otpCooldown > 0 && styles.resendLabelDisabled]}
              >
                {otpCooldown > 0 ? `Gửi lại sau ${otpCooldown}s` : 'Gửi lại mã'}
              </Button>
            </View>
          </SectionCard>
        </View>

        <NoticeSnackbar visible={!!snackbar} message={snackbar} severity={snackbarSeverity} onDismiss={() => setSnackbar('')} />
      </SafeAreaView>
    );
  }

  if (step === 'choice') {
    return (
      <SafeAreaView style={styles.container} edges={['bottom']}>
        <View style={styles.centeredContent}>
          <SectionCard accentColor={GRADIENTS.emerald[0]} style={styles.choiceCard}>
            <View style={styles.choiceInner}>
              <View style={styles.successCircle}>
                <MaterialCommunityIcons name="check" size={40} color={GRADIENTS.emerald[0]} />
              </View>
              <Text variant="headlineSmall" style={styles.choiceTitle}>Đăng ký thành công</Text>
              <Text style={styles.choiceSubtitle}>
                Bạn có muốn đăng ký khuôn mặt để đăng nhập nhanh tại cổng thư viện không?
              </Text>
              <Button
                mode="contained"
                onPress={() => setStep('consent')}
                contentStyle={styles.primaryBtn}
                labelStyle={styles.primaryBtnLabel}
                style={styles.primaryBtnWrapper}
              >
                Đăng ký khuôn mặt
              </Button>
              <Button mode="text" onPress={() => navigation.replace('Login')} labelStyle={styles.skipLabel}>
                Bỏ qua
              </Button>
            </View>
          </SectionCard>
        </View>
        <NoticeSnackbar visible={!!snackbar} message={snackbar} severity={snackbarSeverity} onDismiss={() => setSnackbar('')} />
      </SafeAreaView>
    );
  }

  if (step === 'consent') {
    return (
      <SafeAreaView style={styles.container} edges={['bottom']}>
        <View style={styles.centeredContent}>
          <SectionCard
            title="Thu thập dữ liệu sinh học"
            icon="file-document-check"
            accentColor={GRADIENTS.amber[0]}
            style={styles.choiceCard}
          >
            <View style={styles.consentInner}>
              <Text style={styles.consentText}>
                Ứng dụng sẽ thu thập hình ảnh khuôn mặt của bạn để xác thực danh tính. Dữ liệu được bảo mật và chỉ dùng cho mục đích xác thực.
              </Text>
              <Button
                mode={consentGiven ? 'contained' : 'outlined'}
                onPress={() => setConsentGiven(!consentGiven)}
                icon={consentGiven ? 'check' : undefined}
                contentStyle={styles.consentBtn}
                style={consentGiven ? styles.consentActiveBtn : styles.consentInactiveBtn}
              >
                {consentGiven ? 'Đã đồng ý' : 'Tôi đồng ý'}
              </Button>
              <Button
                mode="contained"
                onPress={() => setStep('face')}
                disabled={!consentGiven}
                contentStyle={styles.primaryBtn}
                labelStyle={styles.primaryBtnLabel}
                style={styles.primaryBtnWrapper}
              >
                Tiếp tục
              </Button>
              <Button mode="text" onPress={() => setStep('choice')} labelStyle={styles.skipLabel}>
                Từ chối
              </Button>
            </View>
          </SectionCard>
        </View>
      </SafeAreaView>
    );
  }

  if (step === 'face') {
    return (
      <SafeAreaView style={styles.container} edges={['bottom']}>
        <SectionCard
          title="Đăng ký khuôn mặt"
          icon="face-recognition"
          accentColor={GRADIENTS.violet[0]}
          style={styles.faceHeaderCard}
        >
          <View style={styles.faceHeaderInner}>
            <Text style={styles.mutedText}>Chụp khuôn mặt từ 4 góc để đăng nhập nhanh sau này.</Text>
          </View>
        </SectionCard>

        <View style={styles.captureContainer}>
          <AutoFaceCapture onFilesReady={handleFaceEnroll} onError={showError} />
        </View>

        {!isUploading ? (
          <View style={styles.faceFooter}>
            <Button mode="text" onPress={() => navigation.replace('Login')} labelStyle={styles.skipLabel}>
              Bỏ qua
            </Button>
          </View>
        ) : null}

        {isUploading ? (
          <LoadingOverlay loading message="Đang đăng ký khuôn mặt..." />
        ) : null}

        <NoticeSnackbar visible={!!snackbar} message={snackbar} severity={snackbarSeverity} onDismiss={() => setSnackbar('')} />
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.headerBar}>
        <Button
          mode="text"
          onPress={() => navigation.goBack()}
          icon="arrow-left"
          compact
          labelStyle={styles.backLabel}
        >
          Quay lại
        </Button>
        <Text variant="titleMedium" style={styles.headerTitle}>Đăng ký</Text>
        <View style={{ width: 60 }} />
      </View>

      <StepIndicator currentStep={step} />

      <ScrollView style={styles.flex} contentContainerStyle={styles.scrollContent} keyboardShouldPersistTaps="handled">
        <SectionCard
          title="Thông tin tài khoản"
          icon="form-textbox"
          accentColor={GRADIENTS.indigo[0]}
        >
          <View style={styles.formInner}>
            <Text style={styles.formSubtitle}>Nhập thông tin để tạo tài khoản độc giả mới.</Text>

            {studentCode || fullName ? (
              <View style={styles.prefillBanner}>
                <MaterialCommunityIcons name="check-circle" size={16} color={GRADIENTS.emerald[0]} />
                <Text style={styles.prefillText}>Đã điền thông tin từ thẻ sinh viên</Text>
              </View>
            ) : null}

            <TextInput
              label="Mã sinh viên"
              value={studentCode}
              onChangeText={setStudentCode}
              mode="outlined"
              autoCapitalize="none"
              left={<TextInput.Icon icon="account" color={theme.colors.onSurfaceVariant} />}
              outlineStyle={styles.inputOutline}
              style={styles.input}
            />
            {studentCodeCheck === 'checking' ? (
              <View style={styles.codeCheckRow}>
                <ActivityIndicator size={14} color={theme.colors.primary} />
                <Text style={styles.codeCheckText}>Đang kiểm tra...</Text>
              </View>
            ) : studentCodeCheck === 'exists' ? (
              <View style={[styles.codeCheckRow, styles.codeCheckRowError]}>
                <MaterialCommunityIcons name="close-circle" size={16} color={theme.colors.error} />
                <Text style={[styles.codeCheckText, { color: theme.colors.error }]}>Mã sinh viên đã tồn tại</Text>
              </View>
            ) : studentCodeCheck === 'available' ? (
              <View style={[styles.codeCheckRow, styles.codeCheckRowSuccess]}>
                <MaterialCommunityIcons name="check-circle" size={16} color={GRADIENTS.emerald[0]} />
                <Text style={[styles.codeCheckText, { color: GRADIENTS.emerald[0] }]}>Mã sinh viên hợp lệ</Text>
              </View>
            ) : null}

            <TextInput
              label="Họ và tên"
              value={fullName}
