          <Text variant="headlineSmall" style={[dhStyles.statValue, { color: c.onSurface }]}>{value}</Text>
        </View>
      </View>
      {pct !== undefined && (
        <View style={[dhStyles.progressBg, { backgroundColor: c.outline }]}>
