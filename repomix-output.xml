      <MaterialCommunityIcons name={icon as any} size={56} color={c.outline} />
      {headline ? (
        <Text variant="titleMedium" style={{ color: c.onSurface, marginTop: 12, fontWeight: '700', textAlign: 'center' }}>{headline}</Text>
