        {patron?.password_auto_generated ? (
          <SectionCard
            title="Mật khẩu mặc định"
            icon="shield-alert"
            accentColor={theme.colors.tertiary}
            right={
              <Button mode="contained-tonal" compact onPress={() => navigation.navigate('ChangePassword')}>
                Đổi
