              />
            </Animated.View>
            <Text style={styles.headerTitle}>
              {isSmoke ? 'CẢNH BÁO PHÁT HIỆN KHÓI' : 'BÁO ĐỘNG CHÁY KHẨN CẤP'}
            </Text>
            <View style={styles.badgeWrap}>
