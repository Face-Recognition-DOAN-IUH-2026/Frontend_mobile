import api from './client';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { AuthTokens, User } from '../types';

export interface LoginRequest {
  email: string;
  password: string;
}

export interface PatronLoginRequest {
  student_code: string;
  password: string;
}

export interface PatronRegisterRequest {
  student_code: string;
  password: string;
  full_name: string;
  class_name?: string;
}

export interface LoginResponse {
  access_token: string;
  refresh_token: string;
  token_type: string;
}

export interface PatronLoginResponse {
  access_token: string;
  token_type: string;
  patron: any;
}

export interface FaceLoginResponse {
  access_token: string;
  refresh_token?: string;
  token_type: string;
}

export const authApi = {
  login: async (data: LoginRequest): Promise<LoginResponse> => {
    const response = await api.post<LoginResponse>('/auth/login', data);
    const tokens: AuthTokens = {
      access_token: response.data.access_token,
      refresh_token: response.data.refresh_token,
      token_type: response.data.token_type,
    };
    await AsyncStorage.setItem('accessToken', tokens.access_token);
    await AsyncStorage.setItem('refreshToken', tokens.refresh_token);
    return response.data;
  },

  patronLogin: async (data: PatronLoginRequest): Promise<PatronLoginResponse> => {
    console.log('patronLogin called with:', data);
    const response = await api.post<PatronLoginResponse>('/patrons/login', data);
    console.log('patronLogin response:', response.data);
    await AsyncStorage.setItem('accessToken', response.data.access_token);
    await AsyncStorage.setItem('patronData', JSON.stringify(response.data.patron));
    console.log('patronLogin stored data');
    return response.data;
  },

  patronRegister: async (data: PatronRegisterRequest): Promise<PatronLoginResponse> => {
    const response = await api.post<PatronLoginResponse>('/patrons/register', data);
    await AsyncStorage.setItem('accessToken', response.data.access_token);
    await AsyncStorage.setItem('patronData', JSON.stringify(response.data.patron));
    return response.data;
  },

  faceLogin: async (imageUri: string): Promise<FaceLoginResponse> => {
    const formData = new FormData();
    formData.append('file', {
      uri: imageUri,
      type: 'image/jpeg',
      name: 'face.jpg',
    } as any);
    const response = await api.post<FaceLoginResponse>('/auth/face-login', formData);
    if (response.data.access_token) {
      await AsyncStorage.setItem('accessToken', response.data.access_token);
    }
    if (response.data.refresh_token) {
      await AsyncStorage.setItem('refreshToken', response.data.refresh_token);
    }
    return response.data;
  },

  refreshToken: async (refreshToken: string): Promise<{ access_token: string }> => {
    const response = await api.post('/auth/refresh', { refresh_token: refreshToken });
    return response.data;
  },

  logout: async (): Promise<void> => {
    await AsyncStorage.multiRemove(['accessToken', 'refreshToken', 'patronData']);
  },

  getCurrentUser: async (): Promise<User> => {
    const response = await api.get<User>('/users/me');
    return response.data;
  },

  getCurrentPatron: async (): Promise<any> => {
    const response = await api.get<any>('/patrons/me');
    return response.data;
  },

  changePassword: async (patronId: string, newPassword: string): Promise<void> => {
    await api.put(`/patrons/${patronId}/password`, {
      new_password: newPassword,
    });
  },
};
</file>

<file path="src/context/AuthContext.tsx">
import React, { createContext, useContext, useState, useEffect, ReactNode } from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { User } from '../types';
import { authApi } from '../api/auth';

interface AuthContextType {
  user: User | null;
  patron: any | null;
  isLoading: boolean;
  isAuthenticated: boolean;
  patronLogin: (studentCode: string, password: string) => Promise<void>;
  faceLogin: (imageUri: string) => Promise<void>;
  logout: () => Promise<void>;
  checkAuth: () => Promise<void>;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<User | null>(null);
  const [patron, setPatron] = useState<any | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  const checkAuth = async () => {
    try {
      const token = await AsyncStorage.getItem('accessToken');
      const patronDataStr = await AsyncStorage.getItem('patronData');
      if (token && patronDataStr) {
        const patronData = JSON.parse(patronDataStr);
        setPatron(patronData);
        setUser({ id: patronData.id, email: patronData.email || '', full_name: patronData.full_name, role: 'patron', password_auto_generated: patronData.password_auto_generated });
      }
    } catch (error) {
      console.error('Auth check failed:', error);
      await authApi.logout();
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    checkAuth();
  }, []);

  const patronLogin = async (studentCode: string, password: string) => {
    setIsLoading(true);
    try {
      console.log('AuthContext patronLogin called');
      const response = await authApi.patronLogin({ student_code: studentCode, password });
      console.log('AuthContext received:', response);
      setPatron(response.patron);
      console.log('setPatron called');
      setUser({ id: response.patron.id, email: response.patron.email || '', full_name: response.patron.full_name, role: 'patron', password_auto_generated: response.patron.password_auto_generated });
      console.log('setUser called');
    } finally {
      setIsLoading(false);
    }
  };

  const faceLogin = async (imageBase64: string) => {
    setIsLoading(true);
    try {
      await authApi.faceLogin(imageBase64);
      const patronData = await authApi.getCurrentPatron();
      await AsyncStorage.setItem('patronData', JSON.stringify(patronData));
      setPatron(patronData);
      setUser({ id: patronData.id, email: patronData.email || '', full_name: patronData.full_name, role: 'patron', password_auto_generated: patronData.password_auto_generated });
    } finally {
      setIsLoading(false);
    }
  };

  const logout = async () => {
    await authApi.logout();
    setUser(null);
    setPatron(null);
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        patron,
        isLoading,
        isAuthenticated: !!user,
        patronLogin,
        faceLogin,
        logout,
        checkAuth,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
}
</file>

